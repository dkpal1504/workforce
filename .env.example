DATABASE_URL="postgresql://workforce_app:change-me@postgres.example.internal:5432/workforce?schema=public&sslmode=require"
JWT_SECRET=change-me-in-production-use-long-random-string
API_PORT=4000
VITE_API_URL=http://localhost:4000
CORS_ORIGINS=https://workforce.example.com
TRUST_PROXY=true
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
MAX_DAILY_HOURS=8
# Shift windows inside the fixed 8a–8p grid (start inclusive, end exclusive). NAME:HH:MM-HH:MM
SHIFTS=GENERAL:09:00-17:00

# --- BadgeView master-data sync (LabourWorks SQL Server) ---
# Enable/disable the in-process sync job. Set to false to disable.
BADGEVIEW_SYNC_ENABLED=false
# Cron expression for the twice-daily sync (default: 06:00 and 18:00).
BADGEVIEW_SYNC_CRON=0 6,18 * * *
# SQL Server connection for the read-only BadgeView source.
BADGEVIEW_DB_HOST=sqlserver.example.internal
BADGEVIEW_DB_PORT=1433
BADGEVIEW_DB_USER=readonly_user
BADGEVIEW_DB_PASSWORD=change-me
BADGEVIEW_DB_NAME=LabourWorks
BADGEVIEW_DB_VIEW=BadgeView
# Whether the SQL Server connection uses encrypted transport (true/false).
BADGEVIEW_DB_ENCRYPT=false

# Snapshot safety. A run below either threshold fails before any absence-based termination.
# Import ACTIVE workers only (default true). A terminated worker is never fetched, so no
# Employee row and no login is created for them. A worker who leaves later is absent from
# the snapshot and is still soft-terminated by the absence sweep. Set to false to import
# terminated workers as inactive rows instead.
BADGEVIEW_SYNC_ACTIVE_ONLY=true

BADGEVIEW_SYNC_MIN_ROWS=1
BADGEVIEW_SYNC_MIN_RATIO=0.9

# --- Clocked attendance hours (in/out) for submitted timesheets ---
# A submitted timesheet day stores the hours the contract worker actually clocked in
# and out, so the Admin can compare them with the hours the supervisor booked. The
# value is NULL on every submit; /attendance-hours (ADMIN) or the cron job below fills
# it from LabourWorks. The join key is the employee ecNo, which the source view calls
# <ID column>; the hours field is <hours column>.
#
# The view belongs to the IT team, so it is CONFIGURATION, not code: adjust the names
# below and the query is rebuilt. The Admin screen shows the resolved view, columns and
# connection, and reports the source error verbatim, so a wrong column name is visible
# instead of silent. The read-only login needs SELECT on the view (the badge-sync login
# often does not have it).
ATTENDANCE_DB_VIEW=dbo.Report_Attendance_Intermediate
ATTENDANCE_DB_ID_COLUMN=IDNo
ATTENDANCE_DB_HOURS_COLUMN=ManHours
# The column that carries the attendance date (confirmed against the live view 2026-09-21).
# CAST(<date column> AS date) = CAST(@workDate AS date).
ATTENDANCE_DB_DATE_COLUMN=Date
# Optional: replace the generated SQL completely. It MUST bind @workDate
# (e.g. "SELECT IDNo, ManHours FROM dbo.Report_Attendance_Intermediate WHERE Att_Date = @workDate").
# Set this when the view already filters the date itself, or when the DBA supplies the
# exact query.
# ATTENDANCE_DB_QUERY=
# Connection defaults to the BadgeView server/login. Override to a read-only login that
# has SELECT on the attendance view.
# ATTENDANCE_DB_NAME=LabourWorks
# ATTENDANCE_DB_USER=
# ATTENDANCE_DB_PASSWORD=
# The in-process job. Off by default, like the badge sync: an external integration is
# switched on deliberately. Cron default = 09:00 and 21:00 daily (off-peak), which is
# what the yard asked for.
ATTENDANCE_HOURS_ENABLED=false
ATTENDANCE_HOURS_CRON=0 9,21 * * *
# Each tick RE-READS today and this many days before it, for non-draft sheets. It
# re-reads days that already have a value too, which is what lets a regularized 0.00
# become 8.00 days later. Size this to the yard's regularization SLA.
ATTENDANCE_HOURS_LOOKBACK_DAYS=7
# The weekly sweep: the whole regularization horizon, but only for days that still
# have nothing usable (no attendance row, no ManHours, or 0.00). It reads the database
# first and asks LabourWorks only about the dates that are actually still pending.
ATTENDANCE_HOURS_SWEEP_ENABLED=true
ATTENDANCE_HOURS_SWEEP_CRON=0 4 * * 0
# How a difference between the stored figure and the source is settled:
#   any     (default) the source is the truth; a later correction wins, up or down
#   improve only fill a gap (NULL / 0) or raise a figure; never lower one automatically
ATTENDANCE_HOURS_OVERWRITE=any
# Days older than this stop being re-checked, so a closed period cannot move under the
# finance team's feet. An Admin can override it deliberately from the screen.
ATTENDANCE_HOURS_MAX_AGE_DAYS=45
# Dev/test only: read the clocked hours from a local JSON or CSV file instead of SQL
# Server (rows: date,IDNo,ManHours). Refused when NODE_ENV=production.
# ATTENDANCE_HOURS_FIXTURE=

# --- Supervisor temporary credential delivery ---
# Queue recipient defaults to IT Support if omitted.
CREDENTIAL_DELIVERY_RECIPIENT=itsupport.shipyard@swan.co.in
CREDENTIAL_DELIVERY_ENABLED=true
CREDENTIAL_DELIVERY_CRON=*/5 * * * *
CREDENTIAL_DELIVERY_BATCH_SIZE=20
TEMP_PASSWORD_EXPIRY_HOURS=24
# Pending deliveries remain queued until SMTP_HOST and SMTP_FROM are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
