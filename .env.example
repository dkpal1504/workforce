DATABASE_URL="postgresql://workforce_app:change-me@postgres.example.internal:5432/workforce?schema=public&sslmode=require"
JWT_SECRET=change-me-in-production-use-long-random-string
API_PORT=4000
VITE_API_URL=http://localhost:4000
CORS_ORIGINS=https://workforce.example.com
TRUST_PROXY=true
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
MAX_DAILY_HOURS=8
# Shift windows inside the fixed 8a–8p grid (start inclusive, end exclusive). NAME:HH:MM-HH:MM
SHIFTS=GENERAL:09:00-17:00

# --- BadgeView master-data sync (LabourWorks SQL Server) ---
# Enable/disable the in-process sync job. Set to false to disable.
BADGEVIEW_SYNC_ENABLED=false
# Cron expression for the twice-daily sync (default: 06:00 and 18:00).
BADGEVIEW_SYNC_CRON=0 6,18 * * *
# SQL Server connection for the read-only BadgeView source.
BADGEVIEW_DB_HOST=sqlserver.example.internal
BADGEVIEW_DB_PORT=1433
BADGEVIEW_DB_USER=readonly_user
BADGEVIEW_DB_PASSWORD=change-me
BADGEVIEW_DB_NAME=LabourWorks
BADGEVIEW_DB_VIEW=BadgeView
# Whether the SQL Server connection uses encrypted transport (true/false).
BADGEVIEW_DB_ENCRYPT=false

# Snapshot safety. A run below either threshold fails before any absence-based termination.
BADGEVIEW_SYNC_MIN_ROWS=1
BADGEVIEW_SYNC_MIN_RATIO=0.9

# --- Supervisor temporary credential delivery ---
# Queue recipient defaults to IT Support if omitted.
CREDENTIAL_DELIVERY_RECIPIENT=itsupport.shipyard@swan.co.in
CREDENTIAL_DELIVERY_ENABLED=true
CREDENTIAL_DELIVERY_CRON=*/5 * * * *
CREDENTIAL_DELIVERY_BATCH_SIZE=20
TEMP_PASSWORD_EXPIRY_HOURS=24
# Pending deliveries remain queued until SMTP_HOST and SMTP_FROM are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
