# Local development only. Copy this file to .env.
# PostgreSQL option (Docker Desktop publishes it on 5433 to avoid a clash with a
# host PostgreSQL on 5432):
DATABASE_URL="postgresql://workforce:workforce@localhost:5433/workforce?schema=public"
# SQLite option for quick local testing — no database server needed, dev only.
# The API refuses a file: URL when NODE_ENV=production.
# DATABASE_URL="file:./dev.db"
JWT_SECRET=local-development-secret-change-before-production
API_PORT=4000
API_HOST=0.0.0.0
VITE_API_URL=http://localhost:4000
DEV_SEED_PASSWORD=WorkforceDev@2026
MAX_DAILY_HOURS=8
# Shared FIRST password for newly registered contract accounts. Most contract workers and
# supervisors have no e-mail address, so a deployment can give them one known first
# password instead of an e-mailed credential; the API then FORCES a password change at
# their first login. Leave it EMPTY to hand out random, e-mailed one-time credentials
# (configure SMTP_* and CREDENTIAL_DELIVERY_ENABLED=true for that).
# It is configuration, never a literal in the source: the production build refuses a
# hardcoded shared password.
BOOTSTRAP_PASSWORD=

SHIFTS=GENERAL:09:00-17:00

# Keep external background integrations off during normal local testing.
BADGEVIEW_SYNC_ENABLED=false
CREDENTIAL_DELIVERY_ENABLED=false
