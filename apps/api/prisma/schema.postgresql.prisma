generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int         @id @default(autoincrement())
  email                   String      @unique
  passwordHash            String      @map("password_hash")
  name                    String
  role                    String
  /// 'SYNC' = provisioned from LabourWorks; 'MANUAL' = application-managed account.
  source                  String      @default("MANUAL")
  employeeId              Int?        @unique @map("employee_id")
  employee                Employee?   @relation(fields: [employeeId], references: [id])
  departmentId            Int?        @map("department_id")
  department              Department? @relation(fields: [departmentId], references: [id])
  sectionId               Int?        @map("section_id")
  scopeSection            Section?    @relation("UserScopeSection", fields: [sectionId], references: [id])
  active                  Boolean     @default(true)
  mustChangePassword      Boolean     @default(false) @map("must_change_password")
  tokenVersion            Int         @default(0) @map("token_version")
  passwordExpiresAt       DateTime?   @map("password_expires_at")
  credentialProvisionedAt DateTime?   @map("credential_provisioned_at")
  credentialSentAt        DateTime?   @map("credential_sent_at")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  teamSelections             DailyTeamSelection[]
  timesheetDays              TimesheetDay[]          @relation("TaggedBy")
  timesheetEntries           TimesheetEntry[]        @relation("TaggedBy")
  approvalsGiven             Approval[]              @relation("Approver")
  conflictsAsSup1            Conflict[]              @relation("Supervisor1")
  conflictsAsSup2            Conflict[]              @relation("Supervisor2")
  conflictsResolved          Conflict[]              @relation("ResolvedBy")
  auditLogs                  AuditLog[]
  allocationsGiven           EmployeeAllocation[]    @relation("EmployeeAllocationAllocatedBy")
  allocationDaysApproved     EmployeeAllocationDay[]      @relation("EmployeeAllocationApprover")
  allocationApprovalsGiven   EmployeeAllocationApproval[] @relation("EmployeeAllocationApprovalApprover")
  manpowerRequestsRequested  ManpowerRequest[]       @relation("RequestedBy")
  manpowerRequestsAssigned   ManpowerRequest[]       @relation("AssignedBy")
  supervisorOverridesCreated SupervisorOverride[]    @relation("SupervisorOverrideCreator")
  credentialDeliveries       CredentialDelivery[]
  organisationOverridesCreated EmployeeOrganisationOverride[] @relation("OrganisationOverrideCreator")
  delegationsAsDelegator     HodDelegation[] @relation("HodDelegationDelegator")
  delegationsAsDelegate      HodDelegation[] @relation("HodDelegationDelegate")
  delegationsCreated         HodDelegation[] @relation("HodDelegationCreator")

  jobOrderProgressPunched   JobOrderProgress[]         @relation("JobOrderProgressPunchedBy")
  jobOrderProgressApproved  JobOrderProgress[]         @relation("JobOrderProgressApprovedBy")
  budgetRevisionsCreated    JobOrderBudgetRevision[]   @relation("JobOrderBudgetRevisionCreator")
  jobOrderProgressRemarks   JobOrderProgressRemark[]   @relation("JobOrderProgressRemarkAuthor")
  @@index([sectionId])
  @@map("users")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  /// 'SYNC' = auto-created from BadgeView BuName (sync owns these, create-missing
  /// only, never overwrites manual edits); 'MANUAL' = admin-managed (editable).
  source    String   @default("MANUAL")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  employees        Employee[]
  users            User[]
  manpowerRequests ManpowerRequest[]
  jobOrders        JobOrder[]
  sections         Section[]
  organisationOverrides EmployeeOrganisationOverride[]
  hodDelegations   HodDelegation[]

  timesheetEntries    TimesheetEntry[]    @relation("TimesheetEntryDepartment")
  employeeAllocations EmployeeAllocation[] @relation("EmployeeAllocationDepartment")
  @@map("departments")
}

model Employee {
  id             Int        @id @default(autoincrement())
  ecNo           String     @unique @map("ec_no")
  name           String
  departmentId   Int        @map("department_id")
  department     Department @relation(fields: [departmentId], references: [id])
  designation    String
  category       String
  /// Canonical employee number. For CLMS rows this is LabourWorks IDCardNo.
  mobile         String?    @map("mobile")
  /// Origin: 'SYNC' (LabourWorks), 'PAYROLL' (HRMS/manual payroll), or 'MANUAL'.
  source         String     @default("MANUAL")
  /// Workforce class: 'CLMS' or 'PAYROLL'.
  employmentType String     @default("PAYROLL") @map("employment_type")
  lastSyncedAt   DateTime?  @map("last_synced_at")
  terminatedAt   DateTime?  @map("terminated_at")
  /// Raw Nature Of Work value from LabourWorks BadgeView.
  natureOfWork   String?    @map("nature_of_work")
  /// Nature of Work -> Grade (Supervisor/Technician/Plumber...). Privilege field:
  /// grade changes that grant supervisor/approver capability are audited admin
  /// actions, not sync or self-service side-effects.
  grade          String?    @map("grade")
  /// Active = present in the current source snapshot (for SYNC rows) or manually
  /// active. Soft-depart: departed workers are active=false (hidden from pickers)
  /// but retained so approved OT/allocations stay on record (liability trail).
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  user                   User?
  teamSelections         DailyTeamSelection[]
  timesheetDays          TimesheetDay[]
  timesheetEntries       TimesheetEntry[]
  conflicts              Conflict[]
  attendanceFeed         AttendanceFeed[]
  manpowerAssignments    ManpowerRequest[]          @relation("AssignedEmployee")
  employeeAllocations    EmployeeAllocation[]
  employeeAllocationDays EmployeeAllocationDay[]
  sectionAssignment      EmployeeSectionAssignment?
  supervisorOverride     SupervisorOverride?
  organisationOverride   EmployeeOrganisationOverride?

  @@index([source])
  @@index([mobile])
  @@index([active])
  @@map("employees")
}

model Section {
  id           Int        @id @default(autoincrement())
  departmentId Int        @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])
  code         String
  name         String
  source       String     @default("MANUAL")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  costCenter          CostCenter?
  employeeAssignments EmployeeSectionAssignment[]
  scopedUsers         User[] @relation("UserScopeSection")
  organisationOverrides EmployeeOrganisationOverride[]
  hodDelegations      HodDelegation[]

  jobOrders           JobOrder[]
  jobOrderProgress    JobOrderProgress[]
  timesheetEntries    TimesheetEntry[]    @relation("TimesheetEntrySection")
  employeeAllocations EmployeeAllocation[] @relation("EmployeeAllocationSection")
  @@unique([departmentId, code])
  @@unique([departmentId, name])
  @@index([departmentId, active])
  @@map("sections")
}

model CostCenter {
  id        Int      @id @default(autoincrement())
  sectionId Int      @unique @map("section_id")
  section   Section  @relation(fields: [sectionId], references: [id])
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@map("cost_centers")
}

model EmployeeSectionAssignment {
  id         Int      @id @default(autoincrement())
  employeeId Int      @unique @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  sectionId  Int      @map("section_id")
  section    Section  @relation(fields: [sectionId], references: [id])
  source     String   @default("MANUAL")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([sectionId])
  @@map("employee_section_assignments")
}

/// Audited PM/Admin organisation mapping. For CLMS rows this overrides the
/// source Department/Section until another explicit remap is made.
model EmployeeOrganisationOverride {
  id           Int        @id @default(autoincrement())
  employeeId   Int        @unique @map("employee_id")
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  departmentId Int        @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])
  sectionId    Int        @map("section_id")
  section      Section    @relation(fields: [sectionId], references: [id])
  createdById  Int?       @map("created_by")
  createdBy    User?      @relation("OrganisationOverrideCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reason       String
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([departmentId, sectionId])
  @@map("employee_organisation_overrides")
}

/// Audited manual promotion of an active CLMS worker to Supervisor.
model SupervisorOverride {
  id          Int       @id @default(autoincrement())
  employeeId  Int       @unique @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id])
  createdById Int?      @map("created_by")
  createdBy   User?     @relation("SupervisorOverrideCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reason      String
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([revokedAt])
  @@map("supervisor_overrides")
}

/// Durable notification queue. Passwords are generated only during delivery and never logged.
model CredentialDelivery {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient String
  purpose   String
  status    String    @default("PENDING")
  attempts  Int       @default(0)
  lastError String?   @map("last_error")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  sentAt    DateTime? @map("sent_at")

  @@index([status, createdAt])
  @@map("credential_deliveries")
}

model SyncException {
  id           Int       @id @default(autoincrement())
  sourceSystem String    @map("source_system")
  externalKey  String    @map("external_key")
  ecNo         String?   @map("ec_no")
  mobile       String?
  errorCode    String    @map("error_code")
  message      String
  occurrences  Int       @default(1)
  status       String    @default("OPEN")
  firstSeenAt  DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  resolvedAt   DateTime? @map("resolved_at")

  @@unique([sourceSystem, externalKey, errorCode])
  @@index([status, lastSeenAt])
  @@map("sync_exceptions")
}

/// Payroll employee manhour allocation (CR#2) — parent day + slot rows.
///
/// Project is mandatory; Work Order is optional. OT is NOT applicable to payroll
/// employees — no OT field exists (structurally incapable of OT).
///
/// Lifecycle: DRAFT (assigning slots) -> SUBMITTED (after employee clicks
/// "Submit for HOD approval") -> HOD_APPROVED / REJECTED. Status-locked: when the
/// parent day is SUBMITTED/APPROVED, slot edits are rejected at the API.
///
/// Owner + role enforcement: an employee allocates only to SELF via the linked
/// Employee (NOT_OWNER guard); only ADMIN may allocate for another employee.
model EmployeeAllocationDay {
  id          Int       @id @default(autoincrement())
  employeeId  Int       @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id])
  workDate    DateTime  @map("work_date")
  status      String    @default("DRAFT") // DRAFT | SUBMITTED | HOD_APPROVED | REJECTED
  remarks     String?
  submittedAt DateTime? @map("submitted_at")
  approvedAt  DateTime? @map("approved_at")
  approverId  Int?      @map("approver_id")
  approver    User?     @relation("EmployeeAllocationApprover", fields: [approverId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  allocations EmployeeAllocation[]
  approvals   EmployeeAllocationApproval[]

  @@unique([employeeId, workDate])
  @@map("employee_allocation_days")
}

/// One slot row per (employee, day, shift slot). shiftSlot = am1|am2|pm1|pm2 (each 2h).
/// projectId is mandatory; jobOrderId is optional. No OT field (payroll cannot have OT).
/// Status lives on the parent day, not on individual slots.
model EmployeeAllocationApproval {
  id              Int                   @id @default(autoincrement())
  allocationDayId Int                   @map("allocation_day_id")
  allocationDay   EmployeeAllocationDay @relation(fields: [allocationDayId], references: [id], onDelete: Cascade)
  approverId      Int                   @map("approver_id")
  approver        User                  @relation("EmployeeAllocationApprovalApprover", fields: [approverId], references: [id])
  action          String
  comment         String?
  resultingStatus String                @map("resulting_status")
  createdAt       DateTime              @default(now()) @map("created_at")

  @@index([approverId, createdAt])
  @@index([allocationDayId])
  @@map("employee_allocation_approvals")
}

model EmployeeAllocation {
  id              Int                   @id @default(autoincrement())
  allocationDayId Int                   @map("allocation_day_id")
  allocationDay   EmployeeAllocationDay @relation(fields: [allocationDayId], references: [id], onDelete: Cascade)
  employeeId      Int                   @map("employee_id")
  employee        Employee              @relation(fields: [employeeId], references: [id])
  workDate        DateTime              @map("work_date")
  shiftSlot       String                @map("shift_slot") // am1 | am2 | pm1 | pm2
  projectId       Int                   @map("project_id")
  project         Project               @relation(fields: [projectId], references: [id])
  jobOrderId      Int?                  @map("job_order_id")
  jobOrder        JobOrder?             @relation(fields: [jobOrderId], references: [id])
  /// Attribution snapshot, same rule as TimesheetEntry: frozen at booking time.
  projectWbsId    Int?                  @map("project_wbs_id")
  projectWbs      ProjectWbs?           @relation("EmployeeAllocationProjectWbs", fields: [projectWbsId], references: [id])
  departmentId    Int?                  @map("department_id")
  department      Department?           @relation("EmployeeAllocationDepartment", fields: [departmentId], references: [id])
  sectionId       Int?                  @map("section_id")
  section         Section?              @relation("EmployeeAllocationSection", fields: [sectionId], references: [id])
  allocatedById   Int                   @map("allocated_by")
  allocatedBy     User                  @relation("EmployeeAllocationAllocatedBy", fields: [allocatedById], references: [id])
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  @@unique([allocationDayId, shiftSlot])
  @@index([employeeId, workDate])
  @@map("employee_allocations")
}

model ProjectWbs {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// WBS number issued by the PM team (the CSV `WBS_NO` column). Unique per
  /// project, not globally. A WBS only groups Job Orders and carries no budget.
  wbsCode   String   @map("wbs_code")
  name      String?
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jobOrders           JobOrder[]
  jobOrdersByProject  JobOrder[]        @relation("JobOrderWbsProject")
  networks            Network[]
  timesheetEntries    TimesheetEntry[]
  employeeAllocations EmployeeAllocation[] @relation("EmployeeAllocationProjectWbs")

  @@unique([projectId, wbsCode])
  /// Exists only so `job_orders` can carry a composite foreign key to (id, projectId),
  /// which makes "the Job Order's Project must be the WBS's own Project" a database
  /// guarantee. Prisma needs the parent pair to be unique to reference it.
  @@unique([id, projectId])
  @@index([projectId, sortOrder])
  @@map("project_wbs")
}

/// Top-level Project — drives the new Job Order master (1900000xxx codes).
/// Separate from ProjectWbs (which is the legacy Project row used by the
/// existing Project Summary page); the two are kept in sync by hand for now.
model Project {
  id           Int      @id @default(autoincrement())
  /// ERP Project number (the CSV `Project_ID` column).
  code         String   @unique
  name         String
  /// Short display token for the Timesheet Entry screen, 1-4 characters, unique
  /// across all projects (A, B, C, D as shown today).
  colorKey     String   @unique @map("color_key")
  /// The single flagged row that holds standing / idle-hours Job Orders. It is
  /// not a commercial project; reports include or exclude it by this flag.
  isNonProject Boolean  @default(false) @map("is_non_project")
  sortOrder    Int      @default(0) @map("sort_order")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  wbsRows             ProjectWbs[]
  networks            Network[]
  jobOrders           JobOrder[]
  employeeAllocations EmployeeAllocation[]
  timesheetEntries    TimesheetEntry[]     @relation("TimesheetEntryProject")

  @@map("projects")
}

/// Numeric-coded Job Order (1900000107 Pipe Spool Installation, etc.).
/// `status` is one of: active, closed, on_hold.
/// `budgetedHours` is in clock hours; null for Non-Project / Standing JOs.
model JobOrder {
  id               Int         @id @default(autoincrement())
  projectId        Int         @map("project_id")
  project          Project     @relation(fields: [projectId], references: [id])
  projectWbsId     Int         @map("project_wbs_id")
  projectWbs       ProjectWbs  @relation(fields: [projectWbsId], references: [id])
  /// Declared ONLY so the database enforces that the Job Order's Project owns its WBS
  /// (a composite foreign key on (project_wbs_id, project_id)). Never navigate through
  /// this field in code - use `projectWbs` and `project`. Removing it would drop the
  /// constraint and silently reopen the inconsistency.
  projectWbsOfProject ProjectWbs @relation("JobOrderWbsProject", fields: [projectWbsId, projectId], references: [id, projectId])
  /// SAP-sourced network, validated against the per-project Network master.
  /// Several Job Orders may share one network; Non-Project rows use a dummy.
  networkId        Int         @map("network_id")
  network          Network     @relation(fields: [networkId], references: [id])
  /// Job Order number, generated manually by the PM team. It repeats across
  /// projects, so it is unique per project only - never globally.
  code             String
  /// `Job_Description` from the CSV.
  name             String
  uomId            Int         @map("uom_id")
  uom              Uom         @relation(fields: [uomId], references: [id])
  budgetedQuantity Float       @default(0) @map("budgeted_quantity")
  budgetedHours    Float       @default(0) @map("budgeted_hours")
  departmentId     Int         @map("department_id")
  department       Department  @relation(fields: [departmentId], references: [id])
  /// Required for project Job Orders. Null only for standing / Non-Project Job
  /// Orders, which any section of the department may book.
  sectionId        Int?        @map("section_id")
  section          Section?    @relation(fields: [sectionId], references: [id])
  /// active | inactive
  status           String      @default("active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  timesheetEntries    TimesheetEntry[]
  employeeAllocations EmployeeAllocation[]
  budgetRevisions     JobOrderBudgetRevision[]
  progressEntries     JobOrderProgress[]

  @@unique([projectId, code])
  @@index([projectWbsId, status])
  @@index([departmentId, status])
  @@index([sectionId])
  @@index([networkId])
  @@map("job_orders")
}

model DailyTeamSelection {
  id           Int       @id @default(autoincrement())
  supervisorId Int       @map("supervisor_id")
  supervisor   User      @relation(fields: [supervisorId], references: [id])
  employeeId   Int       @map("employee_id")
  employee     Employee  @relation(fields: [employeeId], references: [id])
  workDate     DateTime  @map("work_date")
  source       String
  createdAt    DateTime  @default(now()) @map("created_at")
  removedAt    DateTime? @map("removed_at")

  @@index([supervisorId, workDate])
  @@index([employeeId, workDate])
  @@map("daily_team_selection")
}

model TimesheetDay {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  workDate   DateTime @map("work_date")
  taggedById Int      @map("tagged_by")
  taggedBy   User     @relation("TaggedBy", fields: [taggedById], references: [id])
  status     String   @default("DRAFT")
  remarks    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  entries   TimesheetEntry[]
  approvals Approval[]

  @@unique([employeeId, workDate, taggedById])
  @@map("timesheet_days")
}

model TimesheetEntry {
  id             Int          @id @default(autoincrement())
  timesheetDayId Int          @map("timesheet_day_id")
  timesheetDay   TimesheetDay @relation(fields: [timesheetDayId], references: [id], onDelete: Cascade)
  employeeId     Int          @map("employee_id")
  employee       Employee     @relation(fields: [employeeId], references: [id])
  workDate       DateTime     @map("work_date")
  /// Legacy 13-hour grid (0-12). Kept for backward compat with the existing
  /// Project Summary / seed rows. New Timesheet Entry writes should use
  /// `shiftSlot` (am1/am2/pm1/pm2) instead.
  hourSlot       Int?         @map("hour_slot")
  /// New 4-shift model: am1 (9a-11a) | am2 (11a-1p) | pm1 (2p-4p) | pm2 (4p-6p).
  shiftSlot      String?      @map("shift_slot")
  /// Overtime hours (1-12) for this employee/day. An OT row has shiftSlot=null,
  /// hourSlot=null, otHours=N, and a jobOrderId. OT is booked to its Project/WBS.
  /// An OT-only holiday day has zero overhead; mixed days keep regular capacity. One OT row
  /// per (employee, workDate, taggedById) is enforced in application code (SQLite
  /// treats NULL as distinct in unique constraints, so the schema can't enforce it).
  otHours        Int?         @map("ot_hours")
  projectWbsId   Int?         @map("project_wbs_id")
  projectWbs     ProjectWbs?  @relation(fields: [projectWbsId], references: [id])
  jobOrderId     Int?         @map("job_order_id")
  jobOrder       JobOrder?    @relation(fields: [jobOrderId], references: [id])
  /// Attribution SNAPSHOT captured when the hours are booked. These buckets are
  /// frozen so a later master-data remap never moves approved history. Do NOT add
  /// a composite FK tying them to the live Job Order: a snapshot may legally
  /// diverge from it after a remap.
  projectId      Int?         @map("project_id")
  project        Project?     @relation("TimesheetEntryProject", fields: [projectId], references: [id])
  departmentId   Int?         @map("department_id")
  department     Department?  @relation("TimesheetEntryDepartment", fields: [departmentId], references: [id])
  sectionId      Int?         @map("section_id")
  section        Section?     @relation("TimesheetEntrySection", fields: [sectionId], references: [id])
  taggedById     Int          @map("tagged_by")
  taggedBy       User         @relation("TaggedBy", fields: [taggedById], references: [id])
  status         String       @default("DRAFT")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // Legacy hour-slot rows AND new shift-slot rows are unique per (employee, date, supervisor).
  // Both columns are nullable, but exactly one of hourSlot / shiftSlot is set per row.
  // SQLite treats NULL as distinct in unique constraints, so the two parallel
  // constraints don't collide. Application code enforces "exactly one" via Zod.
  @@unique([employeeId, workDate, hourSlot, taggedById], name: "timesheet_entry_hourSlot_unique")
  @@unique([employeeId, workDate, shiftSlot, taggedById], name: "timesheet_entry_shiftSlot_unique")
  @@index([workDate, taggedById])
  @@index([workDate, jobOrderId])
  @@map("timesheet_entries")
}

model Approval {
  id             Int          @id @default(autoincrement())
  timesheetDayId Int          @map("timesheet_day_id")
  timesheetDay   TimesheetDay @relation(fields: [timesheetDayId], references: [id])
  approverId     Int          @map("approver_id")
  approver       User         @relation("Approver", fields: [approverId], references: [id])
  action         String
  comment        String?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("approvals")
}

model Conflict {
  id            Int       @id @default(autoincrement())
  employeeId    Int       @map("employee_id")
  employee      Employee  @relation(fields: [employeeId], references: [id])
  workDate      DateTime  @map("work_date")
  supervisorId1 Int       @map("supervisor_id_1")
  supervisor1   User      @relation("Supervisor1", fields: [supervisorId1], references: [id])
  supervisorId2 Int       @map("supervisor_id_2")
  supervisor2   User      @relation("Supervisor2", fields: [supervisorId2], references: [id])
  status        String    @default("OPEN")
  resolvedById  Int?      @map("resolved_by")
  resolvedBy    User?     @relation("ResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt    DateTime? @map("resolved_at")
  detectedAt    DateTime  @default(now()) @map("detected_at")

  @@map("conflicts")
}

model ManpowerRequest {
  id                 Int        @id @default(autoincrement())
  requestingDeptId   Int        @map("requesting_dept_id")
  requestingDept     Department @relation(fields: [requestingDeptId], references: [id])
  requestedById      Int        @map("requested_by")
  requestedBy        User       @relation("RequestedBy", fields: [requestedById], references: [id])
  headcount          Int
  workDate           DateTime   @map("work_date")
  status             String     @default("OPEN")
  assignedEmployeeId Int?       @map("assigned_employee_id")
  assignedEmployee   Employee?  @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id])
  assignedById       Int?       @map("assigned_by")
  assignedBy         User?      @relation("AssignedBy", fields: [assignedById], references: [id])
  notes              String?
  createdAt          DateTime   @default(now()) @map("created_at")

  @@map("manpower_requests")
}

model AttendanceFeed {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  workDate   DateTime @map("work_date")
  present    Boolean
  source     String   @default("CLMS")
  importedAt DateTime @default(now()) @map("imported_at")

  @@unique([employeeId, workDate])
  @@map("attendance_feed")
}

model CostRate {
  id            Int       @id @default(autoincrement())
  category      String
  ratePerHour   Float     @map("rate_per_hour")
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([category, effectiveFrom])
  @@map("cost_rates")
}

/// Delegated HOD approval cover. The delegate must already hold an HOD account for
/// the same Department+Section (approval authorization is unchanged — this record
/// makes the cover explicit, time-boxed and auditable). The delegator keeps their
/// own approval rights.
model HodDelegation {
  id             Int        @id @default(autoincrement())
  delegatorId    Int        @map("delegator_id")
  delegator      User       @relation("HodDelegationDelegator", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegateUserId Int        @map("delegate_user_id")
  delegateUser   User       @relation("HodDelegationDelegate", fields: [delegateUserId], references: [id], onDelete: Cascade)
  departmentId   Int        @map("department_id")
  department     Department @relation(fields: [departmentId], references: [id])
  sectionId      Int        @map("section_id")
  section        Section    @relation(fields: [sectionId], references: [id])
  fromDate       DateTime   @map("from_date")
  toDate         DateTime   @map("to_date")
  reason         String
  createdById    Int?       @map("created_by")
  createdBy      User?      @relation("HodDelegationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  revokedAt      DateTime?  @map("revoked_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  // No DB unique constraint on (delegate, section, fromDate): a revoked delegation
  // must remain re-creatable for the same start date (it is retained as history).
  // Genuine duplicates are rejected by the overlap guard in the POST handler below.
  @@index([sectionId, fromDate, toDate])
  @@index([delegatorId, revokedAt])
  @@index([delegateUserId, sectionId])
  @@map("hod_delegations")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_log")
}

/// Unit of measure master (MT, SQM, NOS ...). Maintained by PM and ADMIN with an
/// example string per row so the maintenance form can explain the field.
model Uom {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  /// Help text shown on the maintenance form.
  example   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jobOrders       JobOrder[]
  budgetRevisions JobOrderBudgetRevision[]

  @@map("uom")
}

/// Network master, scoped per project. Manual until the SAP sync lands in phase 2
/// (then `source` becomes 'SAP'). Validated on Job Order upload.
model Network {
  id        Int        @id @default(autoincrement())
  projectId Int        @map("project_id")
  project   Project    @relation(fields: [projectId], references: [id])
  /// A Network belongs to a WBS element, not to the whole project. One Network
  /// number never spans two WBS rows of the same project (confirmed by the user),
  /// so the Job Order upload validates the Network against the WBS on its own line.
  wbsId     Int        @map("wbs_id")
  wbs       ProjectWbs @relation(fields: [wbsId], references: [id])
  code      String
  name      String?
  source    String     @default("MANUAL")
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  jobOrders JobOrder[]

  @@unique([projectId, code])
  @@index([projectId, active])
  @@index([wbsId, active])
  @@map("networks")
}

/// Effective-dated budget revision. Revision 1 is the budget set when the Job
/// Order was created. Consumption is always compared against the revision in
/// force on the WORK DATE, so a past month keeps the budget it was measured
/// against. No approval step: the PM is the custodian.
model JobOrderBudgetRevision {
  id               Int      @id @default(autoincrement())
  jobOrderId       Int      @map("job_order_id")
  jobOrder         JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  revisionNo       Int      @map("revision_no")
  budgetedHours    Float    @default(0) @map("budgeted_hours")
  budgetedQuantity Float    @default(0) @map("budgeted_quantity")
  uomId            Int?     @map("uom_id")
  uom              Uom?     @relation(fields: [uomId], references: [id])
  effectiveFrom    DateTime @map("effective_from")
  reason           String?
  createdById      Int?     @map("created_by")
  createdBy        User?    @relation("JobOrderBudgetRevisionCreator", fields: [createdById], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([jobOrderId, revisionNo])
  @@index([jobOrderId, effectiveFrom])
  @@map("job_order_budget_revisions")
}

/// Daily cumulative quantity punched by an HOD and approved by a PM.
/// `revisionNo` keeps superseded rows: a rejected or sent-back entry stays as
/// history and the correction is added as the next revision.
model JobOrderProgress {
  id                 Int       @id @default(autoincrement())
  jobOrderId         Int       @map("job_order_id")
  jobOrder           JobOrder  @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  progressDate       DateTime  @map("progress_date")
  /// Cumulative quantity as punched (not a daily increment).
  cumulativeQuantity Float     @map("cumulative_quantity")
  revisionNo         Int       @default(1) @map("revision_no")
  /// The section the progress was punched for. A department-level HOD selects it;
  /// a section-scoped HOD has it pre-selected.
  sectionId          Int?      @map("section_id")
  section            Section?  @relation(fields: [sectionId], references: [id])
  /// SUBMITTED | APPROVED | REJECTED | SENT_BACK
  status             String    @default("SUBMITTED")
  punchedById        Int       @map("punched_by")
  punchedBy          User      @relation("JobOrderProgressPunchedBy", fields: [punchedById], references: [id])
  approvedById       Int?      @map("approved_by")
  approvedBy         User?     @relation("JobOrderProgressApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime? @map("approved_at")
  remarks            String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  remarkHistory      JobOrderProgressRemark[]

  @@unique([jobOrderId, progressDate, revisionNo])
  @@index([status, progressDate])
  @@index([jobOrderId, status])
  @@map("job_order_progress")
}

/// Every remark written against a quantity progress entry, kept in order and never
/// overwritten. The progress row also keeps the latest one in `remarks` for
/// convenience; this table is the reportable history (who wrote what, when, and at
/// which stage: punched, amended, approved, rejected or sent back).
model JobOrderProgressRemark {
  id         Int              @id @default(autoincrement())
  progressId Int              @map("progress_id")
  progress   JobOrderProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  /// PUNCH | AMEND | APPROVE | REJECT | SEND_BACK
  kind       String
  remark     String
  authorId   Int?             @map("author_id")
  author     User?            @relation("JobOrderProgressRemarkAuthor", fields: [authorId], references: [id])
  authorRole String           @map("author_role")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([progressId, createdAt])
  @@map("job_order_progress_remarks")
}
