generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int         @id @default(autoincrement())
  email                   String      @unique
  passwordHash            String      @map("password_hash")
  name                    String
  role                    String
  /// 'SYNC' = provisioned from LabourWorks; 'MANUAL' = application-managed account.
  source                  String      @default("MANUAL")
  employeeId              Int?        @unique @map("employee_id")
  employee                Employee?   @relation(fields: [employeeId], references: [id])
  departmentId            Int?        @map("department_id")
  department              Department? @relation(fields: [departmentId], references: [id])
  sectionId               Int?        @map("section_id")
  scopeSection            Section?    @relation("UserScopeSection", fields: [sectionId], references: [id])
  /// The Sections this user may act within. EMPTY means every Section of `departmentId`.
  /// `sectionId` above is the legacy mirror (first section, or null) — see UserScopeSection.
  scopeSections           UserScopeSection[] @relation("UserScopeSections")
  active                  Boolean     @default(true)
  mustChangePassword      Boolean     @default(false) @map("must_change_password")
  tokenVersion            Int         @default(0) @map("token_version")
  passwordExpiresAt       DateTime?   @map("password_expires_at")
  credentialProvisionedAt DateTime?   @map("credential_provisioned_at")
  credentialSentAt        DateTime?   @map("credential_sent_at")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  teamSelections             DailyTeamSelection[]
  timesheetDays              TimesheetDay[]          @relation("TaggedBy")
  timesheetEntries           TimesheetEntry[]        @relation("TaggedBy")
  approvalsGiven             Approval[]              @relation("Approver")
  conflictsAsSup1            Conflict[]              @relation("Supervisor1")
  conflictsAsSup2            Conflict[]              @relation("Supervisor2")
  conflictsResolved          Conflict[]              @relation("ResolvedBy")
  auditLogs                  AuditLog[]
  allocationsGiven           EmployeeAllocation[]    @relation("EmployeeAllocationAllocatedBy")
  allocationDaysApproved     EmployeeAllocationDay[]      @relation("EmployeeAllocationApprover")
  allocationApprovalsGiven   EmployeeAllocationApproval[] @relation("EmployeeAllocationApprovalApprover")
  manpowerRequestsRequested  ManpowerRequest[]       @relation("RequestedBy")
  manpowerRequestsAssigned   ManpowerRequest[]       @relation("AssignedBy")
  supervisorOverridesCreated SupervisorOverride[]    @relation("SupervisorOverrideCreator")
  credentialDeliveries       CredentialDelivery[]
  organisationOverridesCreated EmployeeOrganisationOverride[] @relation("OrganisationOverrideCreator")
  delegationsAsDelegator     HodDelegation[] @relation("HodDelegationDelegator")
  delegationsAsDelegate      HodDelegation[] @relation("HodDelegationDelegate")
  delegationsCreated         HodDelegation[] @relation("HodDelegationCreator")
  calendarExceptionsApproved CalendarException[] @relation("CalendarExceptionApprover")

  jobOrderProgressPunched   JobOrderProgress[]         @relation("JobOrderProgressPunchedBy")
  jobOrderProgressApproved  JobOrderProgress[]         @relation("JobOrderProgressApprovedBy")
  budgetRevisionsCreated    JobOrderBudgetRevision[]   @relation("JobOrderBudgetRevisionCreator")
  jobOrderProgressRemarks   JobOrderProgressRemark[]   @relation("JobOrderProgressRemarkAuthor")
  @@index([sectionId])
  projectManagerAssignments        ProjectManagerAssignment[] @relation("ProjectManagerAssignments")
  projectManagerAssignmentsCreated ProjectManagerAssignment[] @relation("ProjectManagerAssignmentCreator")

    /// Where Workforce writes to this person (the login e-mail may be a <ecno>@employee.local handle).
  notificationEmail String? @map("notification_email")

  jobOrdersOwned        JobOrder[] @relation("JobOrderOwner")
  threadsOpened         JobOrderThread[] @relation("ThreadOpenedBy")
  threadsResolved       JobOrderThread[] @relation("ThreadResolvedBy")
  threadsLastMessage    JobOrderThread[] @relation("ThreadLastMessageBy")
  messagesAuthored      JobOrderMessage[] @relation("MessageAuthor")
  messagesEdited        JobOrderMessage[] @relation("MessageEditor")
  threadParticipations  JobOrderThreadParticipant[] @relation("ThreadParticipant")
  threadParticipantsAdded JobOrderThreadParticipant[] @relation("ThreadParticipantAddedBy")
  replyTokensCreated    JobOrderReplyToken[] @relation("ReplyTokenCreator")
  commitmentsOwned      JobOrderCommitment[] @relation("CommitmentOwner")
  attachmentsUploaded   JobOrderMessageAttachment[] @relation("AttachmentUploader")
  assistantUsage        AssistantUsage[] @relation("AssistantUsageUser")

@@map("users")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  /// 'SYNC' = auto-created from BadgeView BuName (sync owns these, create-missing
  /// only, never overwrites manual edits); 'MANUAL' = admin-managed (editable).
  source    String   @default("MANUAL")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  employees        Employee[]
  users            User[]
  manpowerRequests ManpowerRequest[]
  jobOrders        JobOrder[]
  sections         Section[]
  organisationOverrides EmployeeOrganisationOverride[]
  hodDelegations   HodDelegation[]

  timesheetEntries    TimesheetEntry[]    @relation("TimesheetEntryDepartment")
  employeeAllocations EmployeeAllocation[] @relation("EmployeeAllocationDepartment")
  slaPolicies SlaPolicy[]

  @@map("departments")
}

model Employee {
  id             Int        @id @default(autoincrement())
  ecNo           String     @unique @map("ec_no")
  name           String
  departmentId   Int        @map("department_id")
  department     Department @relation(fields: [departmentId], references: [id])
  designation    String
  category       String
  /// Canonical employee number. For CLMS rows this is LabourWorks IDCardNo.
  mobile         String?    @map("mobile")
  /// Origin: 'SYNC' (LabourWorks), 'PAYROLL' (HRMS/manual payroll), or 'MANUAL'.
  source         String     @default("MANUAL")
  /// Workforce class: 'CLMS' or 'PAYROLL'.
  employmentType String     @default("PAYROLL") @map("employment_type")
  lastSyncedAt   DateTime?  @map("last_synced_at")
  terminatedAt   DateTime?  @map("terminated_at")
  /// Raw Nature Of Work value from LabourWorks BadgeView.
  natureOfWork   String?    @map("nature_of_work")
  /// Nature of Work -> Grade (Supervisor/Technician/Plumber...). Privilege field:
  /// grade changes that grant supervisor/approver capability are audited admin
  /// actions, not sync or self-service side-effects.
  grade          String?    @map("grade")
  /// Active = present in the current source snapshot (for SYNC rows) or manually
  /// active. Soft-depart: departed workers are active=false (hidden from pickers)
  /// but retained so approved OT/allocations stay on record (liability trail).
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  user                   User?
  teamSelections         DailyTeamSelection[]
  timesheetDays          TimesheetDay[]
  timesheetEntries       TimesheetEntry[]
  conflicts              Conflict[]
  attendanceFeed         AttendanceFeed[]
  manpowerAssignments    ManpowerRequest[]          @relation("AssignedEmployee")
  employeeAllocations    EmployeeAllocation[]
  employeeAllocationDays EmployeeAllocationDay[]
  sectionAssignment      EmployeeSectionAssignment?
  supervisorOverride     SupervisorOverride?
  organisationOverride   EmployeeOrganisationOverride?
  attendanceDays         AttendanceDay[]

  @@index([source])
  @@index([mobile])
  @@index([active])
  @@map("employees")
}

model Section {
  id           Int        @id @default(autoincrement())
  departmentId Int        @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])
  code         String
  name         String
  source       String     @default("MANUAL")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  costCenter          CostCenter?
  employeeAssignments EmployeeSectionAssignment[]
  scopedUsers         User[] @relation("UserScopeSection")
  scopeGrants         UserScopeSection[] @relation("SectionScopeUsers")
  organisationOverrides EmployeeOrganisationOverride[]
  hodDelegations      HodDelegation[]

  jobOrders           JobOrder[]
  jobOrderProgress    JobOrderProgress[]
  timesheetEntries    TimesheetEntry[]    @relation("TimesheetEntrySection")
  employeeAllocations EmployeeAllocation[] @relation("EmployeeAllocationSection")
  @@unique([departmentId, code])
  @@unique([departmentId, name])
  @@index([departmentId, active])
  @@map("sections")
}

/// The Sections a user may act within. ONE ROW PER SECTION.
///
/// This replaces the authority role of the single `User.sectionId` scalar, which is kept as a
/// legacy mirror (first section, or null for department-wide — see `legacySectionId` in
/// services/userScope.ts) so un-converted call sites keep working during the batched conversion,
/// and so an API-only rollback still functions.
///
/// EMPTY SET is meaningful: a user with a Department and NO rows here is DEPARTMENT-WIDE (every
/// Section of that Department) — exactly what `User.sectionId = null` means today. That is how
/// "Section Head for one whole Department" is expressed.
///
/// Every row's section MUST belong to that user's own Department. The write path enforces it
/// (`validateScopeSections`), and the read path (`hodScopeMatchesSet` in services/roleAccess.ts)
/// gates on the Department FIRST, so even a stale row can never reach across Departments.
model UserScopeSection {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation("UserScopeSections", fields: [userId], references: [id], onDelete: Cascade)
  sectionId Int      @map("section_id")
  section   Section  @relation("SectionScopeUsers", fields: [sectionId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, sectionId])
  @@index([sectionId])
  @@map("user_scope_sections")
}

model CostCenter {
  id        Int      @id @default(autoincrement())
  sectionId Int      @unique @map("section_id")
  section   Section  @relation(fields: [sectionId], references: [id])
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@map("cost_centers")
}

model EmployeeSectionAssignment {
  id         Int      @id @default(autoincrement())
  employeeId Int      @unique @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  sectionId  Int      @map("section_id")
  section    Section  @relation(fields: [sectionId], references: [id])
  source     String   @default("MANUAL")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([sectionId])
  @@map("employee_section_assignments")
}

/// Audited PM/Admin organisation mapping. For CLMS rows this overrides the
/// source Department/Section until another explicit remap is made.
model EmployeeOrganisationOverride {
  id           Int        @id @default(autoincrement())
  employeeId   Int        @unique @map("employee_id")
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  departmentId Int        @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])
  sectionId    Int        @map("section_id")
  section      Section    @relation(fields: [sectionId], references: [id])
  createdById  Int?       @map("created_by")
  createdBy    User?      @relation("OrganisationOverrideCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reason       String
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([departmentId, sectionId])
  @@map("employee_organisation_overrides")
}

/// Audited manual promotion of an active CLMS worker to Supervisor.
model SupervisorOverride {
  id          Int       @id @default(autoincrement())
  employeeId  Int       @unique @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id])
  createdById Int?      @map("created_by")
  createdBy   User?     @relation("SupervisorOverrideCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reason      String
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([revokedAt])
  @@map("supervisor_overrides")
}

/// Durable notification queue. Passwords are generated only during delivery and never logged.
model CredentialDelivery {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient String
  purpose   String
  status    String    @default("PENDING")
  attempts  Int       @default(0)
  lastError String?   @map("last_error")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  sentAt    DateTime? @map("sent_at")

  @@index([status, createdAt])
  @@map("credential_deliveries")
}

model SyncException {
  id           Int       @id @default(autoincrement())
  sourceSystem String    @map("source_system")
  externalKey  String    @map("external_key")
  ecNo         String?   @map("ec_no")
  mobile       String?
  errorCode    String    @map("error_code")
  message      String
  occurrences  Int       @default(1)
  status       String    @default("OPEN")
  firstSeenAt  DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  resolvedAt   DateTime? @map("resolved_at")

  @@unique([sourceSystem, externalKey, errorCode])
  @@index([status, lastSeenAt])
  @@map("sync_exceptions")
}

/// Payroll employee manhour allocation (CR#2) — parent day + slot rows.
///
/// Project is mandatory; Work Order is optional. OT is NOT applicable to payroll
/// employees — no OT field exists (structurally incapable of OT).
///
/// Lifecycle: DRAFT (assigning slots) -> SUBMITTED (after employee clicks
/// "Submit for HOD approval") -> HOD_APPROVED / REJECTED. Status-locked: when the
/// parent day is SUBMITTED/APPROVED, slot edits are rejected at the API.
///
/// Owner + role enforcement: an employee allocates only to SELF via the linked
/// Employee (NOT_OWNER guard); only ADMIN may allocate for another employee.
model EmployeeAllocationDay {
  id          Int       @id @default(autoincrement())
  employeeId  Int       @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id])
  workDate    DateTime  @map("work_date")
  status      String    @default("DRAFT") // DRAFT | SUBMITTED | HOD_APPROVED | REJECTED
  remarks     String?
  submittedAt DateTime? @map("submitted_at")
  approvedAt  DateTime? @map("approved_at")
  approverId  Int?      @map("approver_id")
  approver    User?     @relation("EmployeeAllocationApprover", fields: [approverId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  allocations EmployeeAllocation[]
  approvals   EmployeeAllocationApproval[]

  @@unique([employeeId, workDate])
  @@map("employee_allocation_days")
}

/// One slot row per (employee, day, shift slot). shiftSlot = am1|am2|pm1|pm2 (each 2h).
/// projectId is mandatory; jobOrderId is optional. No OT field (payroll cannot have OT).
/// Status lives on the parent day, not on individual slots.
model EmployeeAllocationApproval {
  id              Int                   @id @default(autoincrement())
  allocationDayId Int                   @map("allocation_day_id")
  allocationDay   EmployeeAllocationDay @relation(fields: [allocationDayId], references: [id], onDelete: Cascade)
  approverId      Int                   @map("approver_id")
  approver        User                  @relation("EmployeeAllocationApprovalApprover", fields: [approverId], references: [id])
  action          String
  comment         String?
  resultingStatus String                @map("resulting_status")
  createdAt       DateTime              @default(now()) @map("created_at")

  @@index([approverId, createdAt])
  @@index([allocationDayId])
  @@map("employee_allocation_approvals")
}

model EmployeeAllocation {
  id              Int                   @id @default(autoincrement())
  allocationDayId Int                   @map("allocation_day_id")
  allocationDay   EmployeeAllocationDay @relation(fields: [allocationDayId], references: [id], onDelete: Cascade)
  employeeId      Int                   @map("employee_id")
  employee        Employee              @relation(fields: [employeeId], references: [id])
  workDate        DateTime              @map("work_date")
  shiftSlot       String                @map("shift_slot") // am1 | am2 | pm1 | pm2
  projectId       Int                   @map("project_id")
  project         Project               @relation(fields: [projectId], references: [id])
  jobOrderId      Int?                  @map("job_order_id")
  jobOrder        JobOrder?             @relation(fields: [jobOrderId], references: [id])
  /// Attribution snapshot, same rule as TimesheetEntry: frozen at booking time.
  projectWbsId    Int?                  @map("project_wbs_id")
  projectWbs      ProjectWbs?           @relation("EmployeeAllocationProjectWbs", fields: [projectWbsId], references: [id])
  departmentId    Int?                  @map("department_id")
  department      Department?           @relation("EmployeeAllocationDepartment", fields: [departmentId], references: [id])
  sectionId       Int?                  @map("section_id")
  section         Section?              @relation("EmployeeAllocationSection", fields: [sectionId], references: [id])
  allocatedById   Int                   @map("allocated_by")
  allocatedBy     User                  @relation("EmployeeAllocationAllocatedBy", fields: [allocatedById], references: [id])
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  @@unique([allocationDayId, shiftSlot])
  @@index([employeeId, workDate])
  @@map("employee_allocations")
}

model ProjectWbs {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// WBS number issued by the PM team (the CSV `WBS_NO` column). Unique per
  /// project, not globally. A WBS only groups Job Orders and carries no budget.
  wbsCode   String   @map("wbs_code")
  name      String?
  sortOrder Int      @default(0) @map("sort_order")
  /// Share of its Project's planned hours that this WBS contributes to the S-curve. NULL means
  /// "equal share" — today's rule, where every active WBS of a project weighs the same. Deliberately a
  /// relative weight and never a percentage that must sum to 100: the curve normalises by the weights
  /// actually present, so a half-configured project still plots instead of dividing by zero.
  plannedWeight Float? @map("planned_weight")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jobOrders           JobOrder[]
  jobOrdersByProject  JobOrder[]        @relation("JobOrderWbsProject")
  networks            Network[]
  timesheetEntries    TimesheetEntry[]
  employeeAllocations EmployeeAllocation[] @relation("EmployeeAllocationProjectWbs")

  @@unique([projectId, wbsCode])
  /// Exists only so `job_orders` can carry a composite foreign key to (id, projectId),
  /// which makes "the Job Order's Project must be the WBS's own Project" a database
  /// guarantee. Prisma needs the parent pair to be unique to reference it.
  @@unique([id, projectId])
  @@index([projectId, sortOrder])
  @@map("project_wbs")
}

/// Top-level Project — drives the new Job Order master (1900000xxx codes).
/// Separate from ProjectWbs (which is the legacy Project row used by the
/// existing Project Summary page); the two are kept in sync by hand for now.
model Project {
  id           Int      @id @default(autoincrement())
  /// ERP Project number (the CSV `Project_ID` column).
  code         String   @unique
  name         String
  /// Short display token for the Timesheet Entry screen, 1-4 characters, unique
  /// across all projects (A, B, C, D as shown today).
  colorKey     String   @unique @map("color_key")
  /// The single flagged row that holds standing / idle-hours Job Orders. It is
  /// not a commercial project; reports include or exclude it by this flag.
  isNonProject Boolean  @default(false) @map("is_non_project")
  sortOrder    Int      @default(0) @map("sort_order")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  wbsRows             ProjectWbs[]
  networks            Network[]
  jobOrders           JobOrder[]
  employeeAllocations EmployeeAllocation[]
  timesheetEntries    TimesheetEntry[]     @relation("TimesheetEntryProject")

  managerAssignments ProjectManagerAssignment[]

  @@map("projects")
}

/// Numeric-coded Job Order (1900000107 Pipe Spool Installation, etc.).
/// `status` is one of: active, closed, on_hold.
/// `budgetedHours` is in clock hours; null for Non-Project / Standing JOs.
model JobOrder {
  id               Int         @id @default(autoincrement())
  projectId        Int         @map("project_id")
  project          Project     @relation(fields: [projectId], references: [id])
  projectWbsId     Int         @map("project_wbs_id")
  projectWbs       ProjectWbs  @relation(fields: [projectWbsId], references: [id])
  /// Declared ONLY so the database enforces that the Job Order's Project owns its WBS
  /// (a composite foreign key on (project_wbs_id, project_id)). Never navigate through
  /// this field in code - use `projectWbs` and `project`. Removing it would drop the
  /// constraint and silently reopen the inconsistency.
  projectWbsOfProject ProjectWbs @relation("JobOrderWbsProject", fields: [projectWbsId, projectId], references: [id, projectId])
  /// SAP-sourced network, validated against the per-project Network master.
  /// Several Job Orders may share one network; Non-Project rows use a dummy.
  networkId        Int         @map("network_id")
  network          Network     @relation(fields: [networkId], references: [id])
  /// Job Order number, generated manually by the PM team. It repeats across
  /// projects, so it is unique per project only - never globally.
  code             String
  /// `Job_Description` from the CSV.
  name             String
  uomId            Int         @map("uom_id")
  uom              Uom         @relation(fields: [uomId], references: [id])
  budgetedQuantity Float       @default(0) @map("budgeted_quantity")
  budgetedHours    Float       @default(0) @map("budgeted_hours")
  departmentId     Int         @map("department_id")
  department       Department  @relation(fields: [departmentId], references: [id])
  /// Required for project Job Orders. Null only for standing / Non-Project Job
  /// Orders, which any section of the department may book.
  sectionId        Int?        @map("section_id")
  section          Section?    @relation(fields: [sectionId], references: [id])
  /// active | inactive
  status           String      @default("active")
  /// OPTIONAL planned window, from the template's Start_Date / End_Date columns. NULL means
  /// "no plan" - continual / standing work - which every report shows as NOT SCHEDULED and never
  /// as on-time. Always UTC midnight on the day named: one kind of value, no time-of-day noise.
  /// The CURRENT plan only (v1): a date that moves is not versioned against a baseline.
  plannedStartDate DateTime? @map("planned_start_date")
  plannedEndDate   DateTime? @map("planned_end_date")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  timesheetEntries    TimesheetEntry[]
  employeeAllocations EmployeeAllocation[]
  budgetRevisions     JobOrderBudgetRevision[]
  progressEntries     JobOrderProgress[]

  /// Who holds this Job Order for conversations. Null = fall back to the Section HOD, then the
  /// department HOD (resolved in services/conversationScope.ts). Explicit beats derived.
  ownerUserId       Int?      @map("owner_user_id")
  owner             User?     @relation("JobOrderOwner", fields: [ownerUserId], references: [id])
  ownerAssignedById Int?     @map("owner_assigned_by")
  ownerAssignedAt   DateTime? @map("owner_assigned_at")

  thread       JobOrderThread?
  commitments  JobOrderCommitment[] @relation("JobOrderCommitments")

  @@unique([projectId, code])
  @@index([projectWbsId, status])
  /// What the application COMMITTED to when a recovery was accepted. Deliberately a separate column from
  /// `plannedEndDate`: the Job Order CSV upload writes the plan from the file and would silently undo an
  /// accepted commitment. Both are shown; a warning appears when they diverge.
  committedFinishDate DateTime? @map("committed_finish_date")
  committedSetAt      DateTime? @map("committed_set_at")
  committedRecoveryId Int?      @map("committed_recovery_id")

  @@index([departmentId, status])
  @@index([sectionId])
  @@index([networkId])
  @@map("job_orders")
}

model DailyTeamSelection {
  id           Int       @id @default(autoincrement())
  supervisorId Int       @map("supervisor_id")
  supervisor   User      @relation(fields: [supervisorId], references: [id])
  employeeId   Int       @map("employee_id")
  employee     Employee  @relation(fields: [employeeId], references: [id])
  workDate     DateTime  @map("work_date")
  source       String
  createdAt    DateTime  @default(now()) @map("created_at")
  removedAt    DateTime? @map("removed_at")

  @@index([supervisorId, workDate])
  @@index([employeeId, workDate])
  @@map("daily_team_selection")
}

model TimesheetDay {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  workDate   DateTime @map("work_date")
  taggedById Int      @map("tagged_by")
  taggedBy   User     @relation("TaggedBy", fields: [taggedById], references: [id])
  status     String   @default("DRAFT")
  remarks    String?
  /// Clocked attendance hours for this employee-day, read from the LabourWorks
  /// attendance view (`ManHours` for `IDNo` = the employee ecNo). NULL means
  /// "not fetched yet": every submit resets it, and only an Admin refresh or the
  /// 09:00 / 21:00 job fills it in. Never written by a supervisor, never part of
  /// the booked-hours arithmetic.
  inOutHours Float?   @map("in_out_hours")
  /// Where `inOutHours` came from: null (never fetched), LABOURWORKS or MANUAL.
  /// A MANUAL value is an Admin decision and no refresh ever overwrites it.
  inOutSource String?  @map("in_out_source")
  /// When a refresh last consulted the source for this day, and how many times it has
  /// been consulted. Together they are the "still pending" evidence: a day that is
  /// still 0 after six checks is a regularization nobody has done yet, not a bug.
  inOutCheckedAt DateTime? @map("in_out_checked_at")
  inOutAttempts  Int      @default(0) @map("in_out_attempts")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  entries   TimesheetEntry[]
  approvals Approval[]

  @@unique([employeeId, workDate, taggedById])
  @@map("timesheet_days")
}

model TimesheetEntry {
  id             Int          @id @default(autoincrement())
  timesheetDayId Int          @map("timesheet_day_id")
  timesheetDay   TimesheetDay @relation(fields: [timesheetDayId], references: [id], onDelete: Cascade)
  employeeId     Int          @map("employee_id")
  employee       Employee     @relation(fields: [employeeId], references: [id])
  workDate       DateTime     @map("work_date")
  /// Legacy 13-hour grid (0-12). Kept for backward compat with the existing
  /// Project Summary / seed rows. New Timesheet Entry writes should use
  /// `shiftSlot` (am1/am2/pm1/pm2) instead.
  hourSlot       Int?         @map("hour_slot")
  /// New 4-shift model: am1 (9a-11a) | am2 (11a-1p) | pm1 (2p-4p) | pm2 (4p-6p).
  shiftSlot      String?      @map("shift_slot")
  /// Overtime hours (1-12) for this employee/day. An OT row has shiftSlot=null,
  /// hourSlot=null, otHours=N, and a jobOrderId. OT is booked to its Project/WBS.
  /// An OT-only holiday day has zero overhead; mixed days keep regular capacity. One OT row
  /// per (employee, workDate, taggedById) is enforced in application code (SQLite
  /// treats NULL as distinct in unique constraints, so the schema can't enforce it).
  otHours        Int?         @map("ot_hours")
  projectWbsId   Int?         @map("project_wbs_id")
  projectWbs     ProjectWbs?  @relation(fields: [projectWbsId], references: [id])
  jobOrderId     Int?         @map("job_order_id")
  jobOrder       JobOrder?    @relation(fields: [jobOrderId], references: [id])
  /// Attribution SNAPSHOT captured when the hours are booked. These buckets are
  /// frozen so a later master-data remap never moves approved history. Do NOT add
  /// a composite FK tying them to the live Job Order: a snapshot may legally
  /// diverge from it after a remap.
  projectId      Int?         @map("project_id")
  project        Project?     @relation("TimesheetEntryProject", fields: [projectId], references: [id])
  departmentId   Int?         @map("department_id")
  department     Department?  @relation("TimesheetEntryDepartment", fields: [departmentId], references: [id])
  sectionId      Int?         @map("section_id")
  section        Section?     @relation("TimesheetEntrySection", fields: [sectionId], references: [id])
  taggedById     Int          @map("tagged_by")
  taggedBy       User         @relation("TaggedBy", fields: [taggedById], references: [id])
  status         String       @default("DRAFT")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // Legacy hour-slot rows AND new shift-slot rows are unique per (employee, date, supervisor).
  // Both columns are nullable, but exactly one of hourSlot / shiftSlot is set per row.
  // SQLite treats NULL as distinct in unique constraints, so the two parallel
  // constraints don't collide. Application code enforces "exactly one" via Zod.
  @@unique([employeeId, workDate, hourSlot, taggedById], name: "timesheet_entry_hourSlot_unique")
  @@unique([employeeId, workDate, shiftSlot, taggedById], name: "timesheet_entry_shiftSlot_unique")
  @@index([workDate, taggedById])
  @@index([workDate, jobOrderId])
  @@map("timesheet_entries")
}

model Approval {
  id             Int          @id @default(autoincrement())
  timesheetDayId Int          @map("timesheet_day_id")
  timesheetDay   TimesheetDay @relation(fields: [timesheetDayId], references: [id])
  approverId     Int          @map("approver_id")
  approver       User         @relation("Approver", fields: [approverId], references: [id])
  action         String
  comment        String?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("approvals")
}

model Conflict {
  id            Int       @id @default(autoincrement())
  employeeId    Int       @map("employee_id")
  employee      Employee  @relation(fields: [employeeId], references: [id])
  workDate      DateTime  @map("work_date")
  supervisorId1 Int       @map("supervisor_id_1")
  supervisor1   User      @relation("Supervisor1", fields: [supervisorId1], references: [id])
  supervisorId2 Int       @map("supervisor_id_2")
  supervisor2   User      @relation("Supervisor2", fields: [supervisorId2], references: [id])
  status        String    @default("OPEN")
  resolvedById  Int?      @map("resolved_by")
  resolvedBy    User?     @relation("ResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt    DateTime? @map("resolved_at")
  detectedAt    DateTime  @default(now()) @map("detected_at")

  @@map("conflicts")
}

model ManpowerRequest {
  id                 Int        @id @default(autoincrement())
  requestingDeptId   Int        @map("requesting_dept_id")
  requestingDept     Department @relation(fields: [requestingDeptId], references: [id])
  requestedById      Int        @map("requested_by")
  requestedBy        User       @relation("RequestedBy", fields: [requestedById], references: [id])
  headcount          Int
  workDate           DateTime   @map("work_date")
  status             String     @default("OPEN")
  assignedEmployeeId Int?       @map("assigned_employee_id")
  assignedEmployee   Employee?  @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id])
  assignedById       Int?       @map("assigned_by")
  assignedBy         User?      @relation("AssignedBy", fields: [assignedById], references: [id])
  notes              String?
  createdAt          DateTime   @default(now()) @map("created_at")

  @@map("manpower_requests")
}

model AttendanceFeed {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  workDate   DateTime @map("work_date")
  present    Boolean
  source     String   @default("CLMS")
  importedAt DateTime @default(now()) @map("imported_at")

  @@unique([employeeId, workDate])
  @@map("attendance_feed")
}

model CostRate {
  id            Int       @id @default(autoincrement())
  category      String
  ratePerHour   Float     @map("rate_per_hour")
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([category, effectiveFrom])
  @@map("cost_rates")
}

/// Delegated HOD approval cover. The delegate must already hold an HOD account for
/// the same Department+Section (approval authorization is unchanged — this record
/// makes the cover explicit, time-boxed and auditable). The delegator keeps their
/// own approval rights.
model HodDelegation {
  id             Int        @id @default(autoincrement())
  delegatorId    Int        @map("delegator_id")
  delegator      User       @relation("HodDelegationDelegator", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegateUserId Int        @map("delegate_user_id")
  delegateUser   User       @relation("HodDelegationDelegate", fields: [delegateUserId], references: [id], onDelete: Cascade)
  departmentId   Int        @map("department_id")
  department     Department @relation(fields: [departmentId], references: [id])
  sectionId      Int        @map("section_id")
  section        Section    @relation(fields: [sectionId], references: [id])
  fromDate       DateTime   @map("from_date")
  toDate         DateTime   @map("to_date")
  reason         String
  createdById    Int?       @map("created_by")
  createdBy      User?      @relation("HodDelegationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  revokedAt      DateTime?  @map("revoked_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  // No DB unique constraint on (delegate, section, fromDate): a revoked delegation
  // must remain re-creatable for the same start date (it is retained as history).
  // Genuine duplicates are rejected by the overlap guard in the POST handler below.
  @@index([sectionId, fromDate, toDate])
  @@index([delegatorId, revokedAt])
  @@index([delegateUserId, sectionId])
  @@map("hod_delegations")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_log")
}

/// Unit of measure master (MT, SQM, NOS ...). Maintained by PM and ADMIN with an
/// example string per row so the maintenance form can explain the field.
model Uom {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  /// Help text shown on the maintenance form.
  example   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jobOrders       JobOrder[]
  budgetRevisions JobOrderBudgetRevision[]

  @@map("uom")
}

/// Network master, scoped per project. Manual until the SAP sync lands in phase 2
/// (then `source` becomes 'SAP'). Validated on Job Order upload.
model Network {
  id        Int        @id @default(autoincrement())
  projectId Int        @map("project_id")
  project   Project    @relation(fields: [projectId], references: [id])
  /// A Network belongs to a WBS element, not to the whole project. One Network
  /// number never spans two WBS rows of the same project (confirmed by the user),
  /// so the Job Order upload validates the Network against the WBS on its own line.
  wbsId     Int        @map("wbs_id")
  wbs       ProjectWbs @relation(fields: [wbsId], references: [id])
  code      String
  name      String?
  source    String     @default("MANUAL")
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  jobOrders JobOrder[]

  @@unique([projectId, code])
  @@index([projectId, active])
  @@index([wbsId, active])
  @@map("networks")
}

/// A Project Manager's assignment to a Project.
///
/// A JOIN TABLE, not `Project.managerId`: one manager holds several projects and one project may
/// hold several managers (cover, handover), and a scalar would make the second manager a migration.
///
/// ROWS ARE NEVER DELETED. Ending an assignment sets `status = "revoked"` and stamps `revokedAt`,
/// so "who managed this project last quarter" stays answerable; a re-assignment REUSES the row
/// (`@@unique([projectId, userId])`) rather than adding a second history line for the same pair.
model ProjectManagerAssignment {
  id           Int       @id @default(autoincrement())
  projectId    Int       @map("project_id")
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       Int       @map("user_id")
  user         User      @relation("ProjectManagerAssignments", fields: [userId], references: [id], onDelete: Cascade)
  /// active | revoked
  status       String    @default("active")
  assignedById Int?      @map("assigned_by")
  assignedBy   User?     @relation("ProjectManagerAssignmentCreator", fields: [assignedById], references: [id])
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  revokedAt    DateTime? @map("revoked_at")
  note         String?

  @@unique([projectId, userId])
  @@index([userId, status])
  @@index([projectId, status])
  @@map("project_manager_assignments")
}


/// One conversation per Job Order (docs/plans/2026-10-19-job-order-conversations.md).
/// Created lazily on the first message. RESOLVED is not deleted: it stays readable and reopens.
/// The eight causes of a delay, as CODES.
///
/// The code is what reports count and it never changes; `label` may be reworded from the header of a
/// report without rewriting history. Seeded by migration, so a fresh database and production agree.
model DelayReason {
  code      String @id
  label     String
  sortOrder Int     @map("sort_order")
  active    Boolean @default(true)

  messages JobOrderMessage[]

  @@map("delay_reasons")
}

/// How long a reply is expected to take, and when to nudge and to escalate.
///
/// Rows, not constants: `department_id` null is the default for everybody, and a department that
/// negotiates a different clock adds its own row without a deploy. Hours are counted from the moment the
/// message was posted; a reply that answers it stops the ladder.
model SlaPolicy {
  id            Int     @id @default(autoincrement())
  /// ESCALATION | RECOVERY
  kind          String
  departmentId  Int?    @map("department_id")
  department    Department? @relation(fields: [departmentId], references: [id])
  responseHours Int     @map("response_hours")
  remindHours   Int     @map("remind_hours")
  escalateHours Int     @map("escalate_hours")
  active        Boolean @default(true)

  @@unique([kind, departmentId])
  @@map("sla_policies")
}

/// A recovery offer: the owner says "I cannot finish by the planned date; here is my date and my
/// manpower", and a PM accepts or rejects it.
///
/// Scalars rather than relations on purpose: this is an append-only record whose whole value is that it
/// survives. A cascade from a thread edit would erase the negotiation that explains a committed date.
model JobOrderRecovery {
  id                Int      @id @default(autoincrement())
  threadId          Int      @map("thread_id")
  messageId         Int      @unique @map("message_id")
  jobOrderId        Int      @map("job_order_id")
  projectWbsId      Int?     @map("project_wbs_id")
  proposedByUserId  Int?     @map("proposed_by_user_id")
  proposedByName    String   @map("proposed_by_name")
  proposedByEmail   String   @map("proposed_by_email")
  revisedFinishDate DateTime @map("revised_finish_date")
  /// [{ trade, headcount, hoursPerDay, fromDate, toDate }] — recorded, never enforced.
  manpowerPlanJson  String?  @map("manpower_plan_json")
  note              String?
  /// PROPOSED | ACCEPTED | REJECTED | SUPERSEDED
  state             String   @default("PROPOSED")
  decidedByUserId   Int?     @map("decided_by_user_id")
  decidedByName     String?  @map("decided_by_name")
  decidedAt         DateTime? @map("decided_at")
  decisionNote      String?  @map("decision_note")
  /// What the commitment replaced and what it set, so an undo restores the exact previous value.
  appliedFrom       DateTime? @map("applied_from")
  appliedTo         DateTime? @map("applied_to")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([jobOrderId, state])
  @@map("job_order_recoveries")
}

/// A constraint on a WBS node: raised by somebody, owned by somebody, closed with a note.
///
/// The register Central Planning reads. Ageing is `now - raised_at` for OPEN rows; `impactDays` is what the
/// raiser STATED, never derived, because a guess dressed as a number is worse than no number.
model WbsHindrance {
  id             Int      @id @default(autoincrement())
  projectWbsId   Int      @map("project_wbs_id")
  jobOrderId     Int?     @map("job_order_id")
  threadId       Int?     @map("thread_id")
  messageId      Int?     @map("message_id")
  /// A delay_reasons code, or OTHER.
  category       String
  description    String
  raisedByUserId Int?     @map("raised_by_user_id")
  raisedByEmail  String   @map("raised_by_email")
  raisedAt       DateTime @default(now()) @map("raised_at")
  ownerUserId    Int?     @map("owner_user_id")
  ownerEmail     String?  @map("owner_email")
  targetDate     DateTime? @map("target_date")
  impactDays     Int?     @map("impact_days")
  /// OPEN | CLOSED | VOID
  state          String   @default("OPEN")
  closedByUserId Int?     @map("closed_by_user_id")
  closedByName   String?  @map("closed_by_name")
  closedAt       DateTime? @map("closed_at")
  closureNote    String?  @map("closure_note")

  @@index([projectWbsId, state])
  @@index([state, raisedAt])
  @@map("wbs_hindrances")
}

model JobOrderThread {
  id              Int      @id @default(autoincrement())
  jobOrderId      Int      @unique @map("job_order_id")
  jobOrder        JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  /// OPEN | RESOLVED
  status          String   @default("OPEN")
  openedById      Int?     @map("opened_by")
  openedBy        User?    @relation("ThreadOpenedBy", fields: [openedById], references: [id])
  openedAt        DateTime @default(now()) @map("opened_at")
  resolvedById    Int?     @map("resolved_by")
  resolvedBy      User?    @relation("ThreadResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt      DateTime? @map("resolved_at")
  lastMessageAt   DateTime @default(now()) @map("last_message_at")
  lastMessageById Int?     @map("last_message_by")
  lastMessageBy   User?    @relation("ThreadLastMessageBy", fields: [lastMessageById], references: [id])
  /// Denormalised for the list and the bell; maintained in the same transaction as a message.
  messageCount    Int      @default(0) @map("message_count")

  messages     JobOrderMessage[]
  participants JobOrderThreadParticipant[]
  tokens       JobOrderReplyToken[]
  commitments  JobOrderCommitment[]

  attachments  JobOrderMessageAttachment[]

  @@index([status, lastMessageAt])
  @@map("job_order_threads")
}

/// Append-only conversation entry. An edit bumps `bodyRevision` and is recorded as a system line;
/// a row is never deleted, and `seq` is the quotable number ("per #7").
model JobOrderMessage {
  id                  Int      @id @default(autoincrement())
  threadId            Int      @map("thread_id")
  thread              JobOrderThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  seq                 Int
  /// FOLLOW_UP | INSTRUCTION | ESCALATION | REPLY | DECISION | SYSTEM
  kind                String
  authorUserId        Int?     @map("author_user_id")
  author              User?    @relation("MessageAuthor", fields: [authorUserId], references: [id])
  /// Always present, even for a magic-link reply: who spoke, in one field.
  authorEmail         String   @map("author_email")
  authorName          String   @map("author_name")
  authorRole          String   @map("author_role")
  /// APP | MAGIC_LINK | SYSTEM
  source              String   @default("APP")
  body                String
  bodyRevision        Int      @default(1) @map("body_revision")
  editedAt            DateTime? @map("edited_at")
  editedById          Int?     @map("edited_by")
  editedBy            User?    @relation("MessageEditor", fields: [editedById], references: [id])
  replyToId           Int?     @map("reply_to_id")
  replyTo             JobOrderMessage? @relation("MessageReply", fields: [replyToId], references: [id])
  replies             JobOrderMessage[] @relation("MessageReply")
  /// The Job Order's operational snapshot at the moment of writing (see the plan, 4.2).
  contextJson         String?  @map("context_json")
  /// A DECISION's proposed change (see 4.3).
  proposalJson        String?  @map("proposal_json")
  escalationDueAt     DateTime? @map("escalation_due_at")
  acknowledgedAt      DateTime? @map("acknowledged_at")
  acknowledgedByEmail String?  @map("acknowledged_by_email")
  /// When a reply is expected by, from the policy in force for this kind at the moment of posting.
  /// Null means no clock (a decision, a system line, a reply that answers something).
  responseDueAt    DateTime? @map("response_due_at")
  /// The message this one answers. Set once, on the reply, so "responded in 6h" is a fact for ever.
  answersMessageId Int?      @map("answers_message_id")
  answersMessage   JobOrderMessage? @relation("MessageAnswers", fields: [answersMessageId], references: [id])
  answeredBy       JobOrderMessage[] @relation("MessageAnswers")
  /// REMIND_HOD | ESCALATE_COO on the SYSTEM line a rung writes. Null on everything else.
  ladderStep       String?   @map("ladder_step")

  /// The cause of the delay this message reports, as a DelayReason code. Nullable: prose is still a
  /// valid reply, and a reason is offered, never demanded. Set once — messages are append-only.
  reasonCode String?      @map("reason_code")
  reason     DelayReason? @relation(fields: [reasonCode], references: [code])

  /// Where the message was raised from when it was not the conversation screen itself
  /// (a Portfolio row, a structure node). Null means the drawer. Closed list in services/conversationOrigins.ts.
  origin              String?
  ipHash              String?  @map("ip_hash")
  createdAt           DateTime @default(now()) @map("created_at")

  recipients  JobOrderMessageRecipient[]
  attachments JobOrderMessageAttachment[]
  commitments JobOrderCommitment[]

  @@unique([threadId, seq])
  @@index([threadId, createdAt])
  @@index([kind, escalationDueAt])
  @@index([reasonCode])
  @@index([responseDueAt, answersMessageId])
  @@map("job_order_messages")
}

model JobOrderThreadParticipant {
  id         Int      @id @default(autoincrement())
  threadId   Int      @map("thread_id")
  thread     JobOrderThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     Int?     @map("user_id")
  user       User?    @relation("ThreadParticipant", fields: [userId], references: [id])
  email      String
  roleAtJoin String   @map("role_at_join")
  addedById  Int?     @map("added_by")
  addedBy    User?    @relation("ThreadParticipantAddedBy", fields: [addedById], references: [id])
  addedAt    DateTime @default(now()) @map("added_at")
  mutedAt    DateTime? @map("muted_at")
  lastReadAt DateTime? @map("last_read_at")
  /// The highest `seq` this person has seen; unread = thread.messageCount - lastReadSeq.
  lastReadSeq Int     @default(0) @map("last_read_seq")

  @@unique([threadId, email])
  @@index([userId])
  @@map("job_order_thread_participants")
}

/// Per-recipient delivery truth, shown on the message ("emailed to X · delivered 14:32"
/// or "not emailed — no address"). A message is never "sent" in the abstract.
model JobOrderMessageRecipient {
  id        Int      @id @default(autoincrement())
  messageId Int      @map("message_id")
  message   JobOrderMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  email     String
  userId    Int?     @map("user_id")
  /// QUEUED | SENT | FAILED | NO_ADDRESS | MUTED
  state     String   @default("QUEUED")
  sentAt    DateTime? @map("sent_at")
  error     String?

  @@index([messageId])
  @@map("job_order_message_recipients")
}

/// A signed, expiring link that lets the holder reply from e-mail without an account.
/// Stored HASHED, bound to one address and one thread, revocable.
model JobOrderReplyToken {
  id          Int      @id @default(autoincrement())
  tokenHash   String   @unique @map("token_hash")
  threadId    Int      @map("thread_id")
  thread      JobOrderThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  email       String
  userId      Int?     @map("user_id")
  createdById Int?     @map("created_by")
  createdBy   User?    @relation("ReplyTokenCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  useCount    Int      @default(0) @map("use_count")
  lastUsedAt  DateTime? @map("last_used_at")

  @@index([threadId, email])
  @@map("job_order_reply_tokens")
}

/// A promise found in a reply ("spools resume Friday"), chased on its due day (see the plan, A4).
model JobOrderCommitment {
  id                  Int      @id @default(autoincrement())
  threadId            Int      @map("thread_id")
  thread              JobOrderThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  messageId           Int      @map("message_id")
  message             JobOrderMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  jobOrderId          Int      @map("job_order_id")
  jobOrder            JobOrder @relation("JobOrderCommitments", fields: [jobOrderId], references: [id], onDelete: Cascade)
  ownerEmail          String   @map("owner_email")
  ownerUserId         Int?     @map("owner_user_id")
  owner               User?    @relation("CommitmentOwner", fields: [ownerUserId], references: [id])
  dueOn               DateTime @map("due_on")
  text                String
  /// OPEN | KEPT | MISSED | DISMISSED
  state               String   @default("OPEN")
  resolvedAt          DateTime? @map("resolved_at")
  chasedAt            DateTime? @map("chased_at")

  @@index([state, dueOn])
  @@index([jobOrderId])
  @@map("job_order_commitments")
}

/// What the assistant was asked to do and what a human did with it. The only way to know whether
/// it is earning its place; also the record that a sent message began as a draft.
model AssistantUsage {
  id               Int      @id @default(autoincrement())
  userId           Int?     @map("user_id")
  user             User?    @relation("AssistantUsageUser", fields: [userId], references: [id])
  action           String
  jobOrderId       Int?     @map("job_order_id")
  threadId         Int?     @map("thread_id")
  model            String
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  /// RETURNED | FAILED | DISABLED | ACCEPTED | EDITED | DISCARDED
  outcome          String
  latencyMs        Int?     @map("latency_ms")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@map("assistant_usage")
}

/// A document attached to a conversation message — drawings, photos, delivery notes, spreadsheets.
/// The bytes live on disk (`ATTACHMENT_DIR`), never in the database; this row is the index, the
/// integrity hash and the access record. A row with `messageId = null` is an upload that has not been
/// sent yet, so an abandoned compose never leaves an orphan on a thread.
model JobOrderMessageAttachment {
  id           Int      @id @default(autoincrement())
  threadId     Int      @map("thread_id")
  thread       JobOrderThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  messageId    Int?     @map("message_id")
  message      JobOrderMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename     String
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  /// The name on disk (opaque); the user-facing name is `filename`.
  storageKey   String   @unique @map("storage_key")
  sha256       String
  uploadedById Int?     @map("uploaded_by")
  uploadedBy   User?    @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([messageId])
  @@index([threadId])
  @@map("job_order_message_attachments")
}
/// Effective-dated budget revision. Revision 1 is the budget set when the Job
/// Order was created. Consumption is always compared against the revision in
/// force on the WORK DATE, so a past month keeps the budget it was measured
/// against. No approval step: the PM is the custodian.
model JobOrderBudgetRevision {
  id               Int      @id @default(autoincrement())
  jobOrderId       Int      @map("job_order_id")
  jobOrder         JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  revisionNo       Int      @map("revision_no")
  budgetedHours    Float    @default(0) @map("budgeted_hours")
  budgetedQuantity Float    @default(0) @map("budgeted_quantity")
  uomId            Int?     @map("uom_id")
  uom              Uom?     @relation(fields: [uomId], references: [id])
  effectiveFrom    DateTime @map("effective_from")
  reason           String?
  createdById      Int?     @map("created_by")
  createdBy        User?    @relation("JobOrderBudgetRevisionCreator", fields: [createdById], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([jobOrderId, revisionNo])
  @@index([jobOrderId, effectiveFrom])
  @@map("job_order_budget_revisions")
}

/// Daily cumulative quantity punched by an HOD and approved by a PM.
/// `revisionNo` keeps superseded rows: a rejected or sent-back entry stays as
/// history and the correction is added as the next revision.
model JobOrderProgress {
  id                 Int       @id @default(autoincrement())
  jobOrderId         Int       @map("job_order_id")
  jobOrder           JobOrder  @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  progressDate       DateTime  @map("progress_date")
  /// Cumulative quantity as punched (not a daily increment).
  cumulativeQuantity Float     @map("cumulative_quantity")
  revisionNo         Int       @default(1) @map("revision_no")
  /// The section the progress was punched for. A department-level HOD selects it;
  /// a section-scoped HOD has it pre-selected.
  sectionId          Int?      @map("section_id")
  section            Section?  @relation(fields: [sectionId], references: [id])
  /// SUBMITTED | APPROVED | REJECTED | SENT_BACK
  status             String    @default("SUBMITTED")
  punchedById        Int       @map("punched_by")
  punchedBy          User      @relation("JobOrderProgressPunchedBy", fields: [punchedById], references: [id])
  approvedById       Int?      @map("approved_by")
  approvedBy         User?     @relation("JobOrderProgressApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime? @map("approved_at")
  remarks            String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  remarkHistory      JobOrderProgressRemark[]

  @@unique([jobOrderId, progressDate, revisionNo])
  @@index([status, progressDate])
  @@index([jobOrderId, status])
  @@map("job_order_progress")
}

/// Every remark written against a quantity progress entry, kept in order and never
/// overwritten. The progress row also keeps the latest one in `remarks` for
/// convenience; this table is the reportable history (who wrote what, when, and at
/// which stage: punched, amended, approved, rejected or sent back).
model JobOrderProgressRemark {
  id         Int              @id @default(autoincrement())
  progressId Int              @map("progress_id")
  progress   JobOrderProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  /// PUNCH | AMEND | APPROVE | REJECT | SEND_BACK
  kind       String
  remark     String
  authorId   Int?             @map("author_id")
  author     User?            @relation("JobOrderProgressRemarkAuthor", fields: [authorId], references: [id])
  authorRole String           @map("author_role")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([progressId, createdAt])
  @@map("job_order_progress_remarks")
}

/// The plant's work calendar: one row per calendar date, resolved once and shared by every report.
///
/// Before this table every denominator was CALENDAR days, which is why a six-day yard reported attendance
/// expected seven days a week and every Sunday read as 599 absences. `dayType` is WORKING, WEEKLY_OFF or
/// HOLIDAY. The evidence counts are stored beside the verdict so a wrong day can be argued with numbers
/// instead of opinion — that is how the 26 Aug 2026 false holiday was found.
model WorkCalendarDate {
  id                Int       @id @default(autoincrement())
  /// UTC midnight of the day: one kind of value, no time-of-day noise.
  workDate          DateTime  @unique @map("work_date")
  /// WORKING | WEEKLY_OFF | HOLIDAY
  dayType           String    @map("day_type")
  /// REGISTER (inferred from the attendance view), DECLARED (the plant calendar), or OVERRIDE (a human said so).
  source            String    @default("REGISTER")
  employeeRows      Int       @default(0) @map("employee_rows")
  presentRows       Int       @default(0) @map("present_rows")
  absentRows        Int       @default(0) @map("absent_rows")
  weeklyOffRows     Int       @default(0) @map("weekly_off_rows")
  holidayFlagRows   Int       @default(0) @map("holiday_flag_rows")
  holidayStatusRows Int       @default(0) @map("holiday_status_rows")
  /// When the attendance source last answered for this date. NULL means "never settled": a report must
  /// say UNKNOWN for that date, never zero.
  settledAt         DateTime? @map("settled_at")
  note              String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([dayType, workDate])
  @@map("work_calendar_date")
}

/// A human decision about a date, which beats whatever the attendance source inferred.
///
/// 4 Sep 2026 is Janmashtami and the register marks it a holiday while the yard may have worked it;
/// 14 Sep 2026 is Ganesh Chaturthi yet 457 men were marked present with no holiday status at all. Neither
/// is a bug to be argued inside a classifier — the decision belongs to the yard, with a reason and a name
/// against it, and every report obeys it from then on.
model CalendarException {
  id         Int      @id @default(autoincrement())
  workDate   DateTime @map("work_date")
  /// WORKING | WEEKLY_OFF | HOLIDAY — what the date IS, per the person entitled to say so.
  dayType    String   @map("day_type")
  /// PLANT for now. SECTION / EMPLOYEE are reserved for a yard that runs more than one calendar.
  scopeType  String   @default("PLANT") @map("scope_type")
  /// 0 for PLANT, never NULL: PostgreSQL treats NULLs as distinct in a unique index, so a nullable scope
  /// would allow two conflicting PLANT decisions for the same date.
  scopeId    Int      @default(0) @map("scope_id")
  reason     String
  approvedBy Int?     @map("approved_by")
  approved   User?    @relation("CalendarExceptionApprover", fields: [approvedBy], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([workDate, scopeType, scopeId])
  @@index([workDate])
  @@map("calendar_exception")
}

/// One settlement pass over a date range. A FAILED or PARTIAL run is the reason a report can say
/// "not settled" instead of printing a confident zero.
model AttendanceSettlementRun {
  id           Int            @id @default(autoincrement())
  scopeFrom    DateTime       @map("scope_from")
  scopeTo      DateTime       @map("scope_to")
  startedAt    DateTime       @default(now()) @map("started_at")
  finishedAt   DateTime?      @map("finished_at")
  /// RUNNING | OK | PARTIAL | FAILED
  status       String         @default("RUNNING")
  /// SQL or FIXTURE. A fixture run can never be mistaken for real attendance.
  source       String         @default("SQL")
  datesSettled Int            @default(0) @map("dates_settled")
  datesFailed  Int            @default(0) @map("dates_failed")
  rowsWritten  Int            @default(0) @map("rows_written")
  /// Per-date anomalies as read: unmatched register ids, status/day-type contradictions, mixed statuses.
  anomalies    Json?
  error        String?
  days         AttendanceDay[]

  @@index([startedAt])
  @@map("attendance_settlement_run")
}

/// One settled man-day: the single answer to "was he at work that day, and for how long".
///
/// Stored rather than recomputed because a report and a review must divide by the same facts, and because
/// LabourWorks rewrites history — a settled row is what the yard believed on the day it settled.
model AttendanceDay {
  id              Int      @id @default(autoincrement())
  /// The view's IDNo. Always present: it is the evidence, even when no Employee matches it.
  registerId      String   @map("register_id")
  /// NULL when the register id has no Employee row — an anomaly that is recorded, never invented away.
  employeeId      Int?     @map("employee_id")
  employee        Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  workDate        DateTime @map("work_date")
  /// Copied from the date's resolved type so a single row is readable on its own.
  dayType         String   @map("day_type")
  /// WORKED | WORKED_HOLIDAY | ABSENT | OFF | UNVERIFIED
  attendanceClass String   @map("attendance_class")
  /// The view's OriginalStatus as read (P, P/WO, P/HL, A, A/HL — or whatever the source invents next).
  status          String   @map("status")
  acceptedHours   Float    @default(0) @map("accepted_hours")
  acceptedOtHours Float    @default(0) @map("accepted_ot_hours")
  clockedHours    Float    @default(0) @map("clocked_hours")
  /// How many view rows produced this man-day, and whether they disagreed about the status.
  registerRows    Int      @default(1) @map("register_rows")
  statusVariants  Int      @default(1) @map("status_variants")
  runId           Int?     @map("run_id")
  run             AttendanceSettlementRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  settledAt       DateTime @default(now()) @map("settled_at")

  @@unique([registerId, workDate])
  @@index([workDate, attendanceClass])
  @@index([employeeId, workDate])
  @@map("attendance_day")
}

/// A frozen review pack. Reviews read this, not the live tables, so a number quoted in a meeting cannot
/// change under it afterwards. `contentHash` proves two copies are the same pack.
model ReportSnapshot {
  id          Int      @id @default(autoincrement())
  /// WEEKLY | MONTHLY | ADHOC
  kind        String
  periodFrom  DateTime @map("period_from")
  periodTo    DateTime @map("period_to")
  frozenAt    DateTime @default(now()) @map("frozen_at")
  frozenById  Int?     @map("frozen_by")
  payload     Json
  contentHash String   @map("content_hash")

  @@unique([kind, periodFrom, periodTo])
  @@index([frozenAt])
  @@map("report_snapshot")
}
