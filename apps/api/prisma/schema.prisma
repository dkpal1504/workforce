generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String
  employeeId   Int?     @unique @map("employee_id")
  employee     Employee? @relation(fields: [employeeId], references: [id])
  departmentId Int?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  teamSelections   DailyTeamSelection[]
  timesheetDays    TimesheetDay[]       @relation("TaggedBy")
  timesheetEntries TimesheetEntry[]     @relation("TaggedBy")
  approvalsGiven   Approval[]           @relation("Approver")
  conflictsAsSup1  Conflict[]           @relation("Supervisor1")
  conflictsAsSup2  Conflict[]           @relation("Supervisor2")
  conflictsResolved Conflict[]          @relation("ResolvedBy")
  auditLogs        AuditLog[]
  manpowerRequestsRequested ManpowerRequest[] @relation("RequestedBy")
  manpowerRequestsAssigned  ManpowerRequest[] @relation("AssignedBy")

  @@map("users")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  employees Employee[]
  users     User[]
  manpowerRequests ManpowerRequest[]
  jobOrders        JobOrder[]

  @@map("departments")
}

model Employee {
  id           Int      @id @default(autoincrement())
  ecNo         String   @unique @map("ec_no")
  name         String
  departmentId Int      @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])
  designation  String
  category     String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user                User?
  teamSelections      DailyTeamSelection[]
  timesheetDays       TimesheetDay[]
  timesheetEntries    TimesheetEntry[]
  conflicts           Conflict[]
  attendanceFeed      AttendanceFeed[]
  manpowerAssignments ManpowerRequest[] @relation("AssignedEmployee")

  @@map("employees")
}

model ProjectWbs {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  wbsCode   String   @map("wbs_code")
  colorKey  String   @map("color_key")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  timesheetEntries TimesheetEntry[]
  jobOrders        JobOrder[]

  @@map("projects_wbs")
}

/// Top-level Project — drives the new Job Order master (1900000xxx codes).
/// Separate from ProjectWbs (which is the legacy Project row used by the
/// existing Project Summary page); the two are kept in sync by hand for now.
model Project {
  id        Int      @id @default(autoincrement())
  code      String   @unique     // PRJ-A / PRJ-N
  name      String              // Project A / Non Project
  colorKey  String   @map("color_key")  // A / B / C / D / N
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  jobOrders JobOrder[]

  @@map("projects")
}

/// Numeric-coded Job Order (1900000107 Pipe Spool Installation, etc.).
/// `status` is one of: active, closed, on_hold.
/// `budgetedHours` is in clock hours; null for Non-Project / Standing JOs.
model JobOrder {
  id            Int       @id @default(autoincrement())
  projectId     Int       @map("project_id")
  project       Project   @relation(fields: [projectId], references: [id])
  /// Optional pointer into the legacy ProjectWbs row so existing Project
  /// Summary totals stay consistent. New code should use projectId directly.
  projectWbsId  Int?      @map("project_wbs_id")
  projectWbs    ProjectWbs? @relation(fields: [projectWbsId], references: [id])
  code          String    @unique   // 1900000107 (all-numeric)
  name          String               // Pipe Spool Installation
  departmentId  Int?      @map("department_id")
  department    Department? @relation(fields: [departmentId], references: [id])
  budgetedHours Float?    @map("budgeted_hours")
  status        String    @default("active")  // active | closed | on_hold
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  timesheetEntries TimesheetEntry[]

  @@index([projectId, status])
  @@index([departmentId])
  @@map("job_orders")
}

model DailyTeamSelection {
  id           Int       @id @default(autoincrement())
  supervisorId Int       @map("supervisor_id")
  supervisor   User      @relation(fields: [supervisorId], references: [id])
  employeeId   Int       @map("employee_id")
  employee     Employee  @relation(fields: [employeeId], references: [id])
  workDate     DateTime  @map("work_date")
  source       String
  createdAt    DateTime  @default(now()) @map("created_at")
  removedAt    DateTime? @map("removed_at")

  @@index([supervisorId, workDate])
  @@index([employeeId, workDate])
  @@map("daily_team_selection")
}

model TimesheetDay {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  workDate   DateTime @map("work_date")
  taggedById Int      @map("tagged_by")
  taggedBy   User     @relation("TaggedBy", fields: [taggedById], references: [id])
  status     String   @default("DRAFT")
  remarks    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  entries   TimesheetEntry[]
  approvals Approval[]

  @@unique([employeeId, workDate, taggedById])
  @@map("timesheet_days")
}

model TimesheetEntry {
  id             Int         @id @default(autoincrement())
  timesheetDayId Int         @map("timesheet_day_id")
  timesheetDay   TimesheetDay @relation(fields: [timesheetDayId], references: [id], onDelete: Cascade)
  employeeId     Int         @map("employee_id")
  employee       Employee    @relation(fields: [employeeId], references: [id])
  workDate       DateTime    @map("work_date")
  /// Legacy 13-hour grid (0-12). Kept for backward compat with the existing
  /// Project Summary / seed rows. New Timesheet Entry writes should use
  /// `shiftSlot` (am1/am2/pm1/pm2) instead.
  hourSlot       Int?        @map("hour_slot")
  /// New 4-shift model: am1 (9a-11a) | am2 (11a-1p) | pm1 (2p-4p) | pm2 (4p-6p).
  shiftSlot      String?     @map("shift_slot")
  projectWbsId   Int?        @map("project_wbs_id")
  projectWbs     ProjectWbs? @relation(fields: [projectWbsId], references: [id])
  jobOrderId     Int?        @map("job_order_id")
  jobOrder       JobOrder?   @relation(fields: [jobOrderId], references: [id])
  taggedById     Int         @map("tagged_by")
  taggedBy       User        @relation("TaggedBy", fields: [taggedById], references: [id])
  status         String      @default("DRAFT")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  // Legacy hour-slot rows AND new shift-slot rows are unique per (employee, date, supervisor).
  // Both columns are nullable, but exactly one of hourSlot / shiftSlot is set per row.
  // SQLite treats NULL as distinct in unique constraints, so the two parallel
  // constraints don't collide. Application code enforces "exactly one" via Zod.
  @@unique([employeeId, workDate, hourSlot, taggedById], name: "timesheet_entry_hourSlot_unique")
  @@unique([employeeId, workDate, shiftSlot, taggedById], name: "timesheet_entry_shiftSlot_unique")
  @@index([workDate, taggedById])
  @@index([workDate, jobOrderId])
  @@map("timesheet_entries")
}

model Approval {
  id             Int         @id @default(autoincrement())
  timesheetDayId Int         @map("timesheet_day_id")
  timesheetDay   TimesheetDay @relation(fields: [timesheetDayId], references: [id])
  approverId     Int         @map("approver_id")
  approver       User        @relation("Approver", fields: [approverId], references: [id])
  action         String
  comment        String?
  createdAt      DateTime    @default(now()) @map("created_at")

  @@map("approvals")
}

model Conflict {
  id            Int       @id @default(autoincrement())
  employeeId    Int       @map("employee_id")
  employee      Employee  @relation(fields: [employeeId], references: [id])
  workDate      DateTime  @map("work_date")
  supervisorId1 Int       @map("supervisor_id_1")
  supervisor1   User      @relation("Supervisor1", fields: [supervisorId1], references: [id])
  supervisorId2 Int       @map("supervisor_id_2")
  supervisor2   User      @relation("Supervisor2", fields: [supervisorId2], references: [id])
  status        String    @default("OPEN")
  resolvedById  Int?      @map("resolved_by")
  resolvedBy    User?     @relation("ResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt    DateTime? @map("resolved_at")
  detectedAt    DateTime  @default(now()) @map("detected_at")

  @@map("conflicts")
}

model ManpowerRequest {
  id                 Int        @id @default(autoincrement())
  requestingDeptId   Int        @map("requesting_dept_id")
  requestingDept     Department @relation(fields: [requestingDeptId], references: [id])
  requestedById      Int        @map("requested_by")
  requestedBy        User       @relation("RequestedBy", fields: [requestedById], references: [id])
  headcount          Int
  workDate           DateTime   @map("work_date")
  status             String     @default("OPEN")
  assignedEmployeeId Int?       @map("assigned_employee_id")
  assignedEmployee   Employee?  @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id])
  assignedById       Int?       @map("assigned_by")
  assignedBy         User?      @relation("AssignedBy", fields: [assignedById], references: [id])
  notes              String?
  createdAt          DateTime   @default(now()) @map("created_at")

  @@map("manpower_requests")
}

model AttendanceFeed {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  workDate   DateTime @map("work_date")
  present    Boolean
  source     String   @default("CLMS")
  importedAt DateTime @default(now()) @map("imported_at")

  @@unique([employeeId, workDate])
  @@map("attendance_feed")
}

model CostRate {
  id            Int      @id @default(autoincrement())
  category      String
  ratePerHour   Float    @map("rate_per_hour")
  effectiveFrom DateTime @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([category, effectiveFrom])
  @@map("cost_rates")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_log")
}
