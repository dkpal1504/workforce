# Copy to .env.production. Never commit the real file.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
DATABASE_URL=postgresql://workforce_app:REPLACE_WITH_URL_ENCODED_PASSWORD@db.example.internal:5432/workforce?schema=public&sslmode=require
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CORS_ORIGINS=https://workforce.example.com
TRUST_PROXY=true
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
MAX_DAILY_HOURS=8
SHIFTS=GENERAL:09:00-17:00
BADGEVIEW_SYNC_ENABLED=false
CREDENTIAL_DELIVERY_ENABLED=false
TZ=Asia/Kolkata
