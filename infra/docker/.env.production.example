# Copy to .env.production. Never commit the real file.
#
# NODE_ENV=production is required: the API refuses to boot without it.
NODE_ENV=production
# Shared FIRST password for newly registered contract accounts (supervisors, employees).
# Most contract workers have no e-mail address, so this is how they get in the first time:
# they log in with it and the API FORCES a password change at that first login (every other
# endpoint answers 403 PASSWORD_CHANGE_REQUIRED until they do).
# Leave it EMPTY to hand out random, e-mailed one-time credentials instead (then configure
# SMTP_* and CREDENTIAL_DELIVERY_ENABLED=true).
# It is configuration, never a literal in the source: the image build refuses a hardcoded
# shared password, and the API logs a warning at boot while this is set.
BOOTSTRAP_PASSWORD=password@SDHI

# The FIRST administrator of a fresh database is created once with
#   docker compose ... run --rm api node apps/api/scripts/create-first-admin.mjs
# ADMIN_PASSWORD is optional: leave it out to start the Admin on BOOTSTRAP_PASSWORD
# and force a change at the first login (docs/PRODUCTION_DEPLOYMENT.md 1b).
ADMIN_EMAIL=admin@swan.co.in
ADMIN_NAME=Platform Admin
# ADMIN_PASSWORD=
API_HOST=0.0.0.0
API_PORT=4000
# Your PostgreSQL server. Example host: 10.5.1.178. URL encode the password (@ -> %40).
# There is no database container in production: this URL is the only wiring.
# Port 5432: this deployment REUSES the PostgreSQL already running on 10.5.1.178 (probed
# 2026-09-22: open, TLS 1.3, password auth) with its own role + database. Use 5439 only if a
# second cluster has to live on that host (docs/PRODUCTION_DEPLOYMENT.md 0.1b). A port is a
# SERVER setting: a client needs no port of its own.
# sslmode: require (this server offers a self-signed TLS cert - the recommended setting) /
# prefer (no TLS on the server) / verify-full (TLS + your CA, docs/PRODUCTION_DEPLOYMENT.md 0.2).
DATABASE_URL=postgresql://workforce_app:REPLACE_WITH_URL_ENCODED_PASSWORD@10.5.1.178:5432/workforce?schema=public&sslmode=require
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# The exact browser origin(s), comma-separated, with NO trailing slash. List EVERY origin your
# users type - the LAN URL today and the HTTPS name later - because a browser sends an `Origin`
# header on every POST, and one that is missing here used to break login with an opaque 500.
# Same-origin calls always work (the SPA calls the API on the same origin), and a foreign origin
# is now refused with 403 ORIGIN_NOT_ALLOWED plus a warning in the api log.
CORS_ORIGINS=http://10.5.1.193:8099,https://workforce.swan.co.in
TRUST_PROXY=true
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Never set this to false in production — the API refuses to start with the login
# throttle disabled.
AUTH_RATE_LIMIT_ENABLED=true
MAX_DAILY_HOURS=8
# Ceiling for a single overtime entry (the API rejects more).
MAX_OT_HOURS=12
SHIFTS=GENERAL:09:00-17:00
# Pin a release instead of :latest when you want a rollback path.
IMAGE_TAG=latest
# --- BadgeView master-data sync (LabourWorks) ---
BADGEVIEW_SYNC_ENABLED=false
BADGEVIEW_SYNC_CRON=0 6,18 * * *
BADGEVIEW_DB_HOST=10.5.1.106
BADGEVIEW_DB_PORT=1433
BADGEVIEW_DB_USER=it
# A value containing '#' MUST be quoted, or dotenv treats the rest as a comment and the
# password silently arrives cut short (symptom: "Login failed for user 'it'").
BADGEVIEW_DB_PASSWORD=
BADGEVIEW_DB_NAME=LabourWorks
BADGEVIEW_DB_VIEW=BadgeView
BADGEVIEW_DB_ENCRYPT=false
# Only ACTIVE workers are imported (a terminated worker gets no row and no login).
BADGEVIEW_SYNC_ACTIVE_ONLY=true
# Snapshot safety: a run below either threshold aborts before any absence-based
# termination, so a broken source feed cannot retire the workforce.
BADGEVIEW_SYNC_MIN_ROWS=1
BADGEVIEW_SYNC_MIN_RATIO=0.9
# Set CREDENTIAL_DELIVERY_ENABLED=true and configure SMTP_* before onboarding users
# from the UI, otherwise new accounts receive no usable password.
CREDENTIAL_DELIVERY_ENABLED=false
CREDENTIAL_DELIVERY_CRON=*/5 * * * *
CREDENTIAL_DELIVERY_RECIPIENT=it.support@yourdomain.example
CREDENTIAL_DELIVERY_BATCH_SIZE=20
TEMP_PASSWORD_EXPIRY_HOURS=24
SMTP_HOST=outlook.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@swan.co.in
SMTP_PASSWORD=X!045555771481uv
SMTP_FROM=noreply@swan.co.in
# Published port of the web container on the Docker host (8080 is taken).
WEB_PORT=8099
# Not cosmetic: "today", the daily hour limits and the 09:00 / 21:00 attendance job all
# use the container's local clock.
TZ=Asia/Kolkata

# --- Clocked attendance hours (in/out) for submitted timesheets ---
# The Admin screen /attendance-hours reads the contract worker's clocked hours from
# LabourWorks and stores them next to the booked hours. The view belongs to IT: the
# names below are configuration, and the read-only login needs SELECT on the view.
ATTENDANCE_DB_VIEW=dbo.Report_Attendance_Intermediate
ATTENDANCE_DB_ID_COLUMN=IDNo
ATTENDANCE_DB_HOURS_COLUMN=ManHours
# The register's own columns (holiday-hours reconciliation and, later, the settlement job). Confirmed
# 2026-10-23; all configurable because the view belongs to IT, and a wrong name fails with the view's real
# column list — so fixing it is an env change, not a rebuild.
# The register is a different object from the Clocked Hours log: Report_Attendance_View holds the day type
# and the accepted figures; Report_Attendance_Intermediate holds one row per punch. Never point both at one.
ATTENDANCE_REGISTER_DB_VIEW=dbo.Report_Attendance_View
# The register is the WHOLE YARD; this app reports on the associates only. Confirmed 2026-10-23:
#   Associates, ASSOCIATE SEZ   (the single value ALL disables the filter entirely)
# Without this filter the register's other card types (EOU contractors) made every date look like a
# non-working day and 4,620 identifiers appeared to have no Employee row.
ATTENDANCE_REGISTER_CARD_TYPES=Associates,ASSOCIATE SEZ
# Terminated workers are excluded too: a terminated man has no attendance rows, so keeping his would put
# someone on the roster who can never be present. NULL is treated as 0 (not terminated) — `= 0` alone would
# drop every unset row, the three-valued-logic trap. Change to `ISNULL(...)=0` semantics here if the
# business wants unset treated as terminated.
# ATTENDANCE_REGISTER_TERMINATED_COLUMN=IsTerminated
# ATTENDANCE_REGISTER_CARD_TYPE_COLUMN=CardType
ATTENDANCE_DB_WEEKLY_OFF_COLUMN=isWeeklyOff
ATTENDANCE_DB_STATUS_COLUMN=OriginalStatus
ATTENDANCE_DB_ACCEPTED_HOURS_COLUMN=AcceptedManHrs
ATTENDANCE_DB_ACCEPTED_OT_COLUMN=AcceptedOT
# SUM (default) when the view holds one row per punch, MAX when it repeats the day total per row.
# ATTENDANCE_HOURS_AGGREGATE=SUM
ATTENDANCE_DB_DATE_COLUMN=Date
# Optional: replace the generated SQL completely; it MUST bind @workDate.
# ATTENDANCE_DB_QUERY=
# The off-peak job (09:00 and 21:00) and the weekly sweep. Both are off/on with the
# single switch below; the sweep only re-checks days that still have nothing usable.
ATTENDANCE_HOURS_ENABLED=false
ATTENDANCE_HOURS_CRON=0 9,21 * * *
ATTENDANCE_HOURS_SWEEP_ENABLED=true
ATTENDANCE_HOURS_SWEEP_CRON=0 4 * * 0
# How long a period keeps being re-checked (regularization can take days), how a
# difference is settled (any = the source wins, improve = never lower automatically),
# and the hard cut-off that stops a closed period from moving.
ATTENDANCE_HOURS_LOOKBACK_DAYS=7
ATTENDANCE_HOURS_MAX_AGE_DAYS=45
ATTENDANCE_HOURS_OVERWRITE=any

# ── Job Order conversations, and the assistant that drafts them ───────────────────────────────────
# The reply link in every notification. MUST be the address people actually open, or the button 404s.
APP_BASE_URL=https://workforce.swan.co.in
# false = record recipients as EMAIL_OFF and send nothing (useful on a test box).
CONVERSATION_EMAIL_ENABLED=true
# The authenticated mailbox. Leave unset to inherit SMTP_FROM.
# CONVERSATION_FROM=noreply@swan.co.in
# display = the author's name on the From line, their address in Reply-To (recommended).
# sender  = the author's address in From - only after IT grants the service account Send As.
CONVERSATION_FROM_MODE=display
# The 15-minute sweep: 8h reminder to the HOD, 24h escalation to the COO, promise chasing,
# and the deletion of uploads that were never sent. WITHOUT THIS THE CLOCK NEVER RUNS.
CONVERSATION_SCHEDULER_ENABLED=true
CONVERSATION_SCHEDULER_MINUTES=15
# Where attachments live INSIDE the container. Must match the `attachments` volume mount in
# compose.production.yml - the api container is read_only and has no writable /app otherwise.
ATTACHMENT_DIR=/app/data/attachments
# Optional assistant. Off unless the endpoint answers; the feature works without it.
ASSISTANT_ENABLED=false
# ASSISTANT_BASE_URL=http://10.5.1.178:8000/v1
# ASSISTANT_MODEL=
# ASSISTANT_API_KEY=
ASSISTANT_TIMEOUT_MS=25000
ASSISTANT_MAX_TOKENS=320

# --- Attendance settlement (work calendar + settled man-days) ------------------------------------------
# Off by default: this job writes thousands of rows, so it is switched on deliberately, never by a deploy.
# Settles TODAY and the last N days each tick, because punches, regularisations and OT approvals arrive
# late; re-settling is idempotent (upsert on register id + date), so a corrected punch simply overwrites.
ATTENDANCE_SETTLEMENT_ENABLED=false
ATTENDANCE_SETTLEMENT_CRON=0 6 * * *
ATTENDANCE_SETTLEMENT_LOOKBACK_DAYS=7
# The register also carries FUTURE-DATED planning rows (every worker pre-marked absent). They are never
# read: the range is clamped to today in the application's timezone.
APP_TIMEZONE=Asia/Kolkata
