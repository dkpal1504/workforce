# Copy to .env.production. Never commit the real file.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
DATABASE_URL=postgresql://workforce_app:REPLACE_WITH_URL_ENCODED_PASSWORD@db.example.internal:5432/workforce?schema=public&sslmode=require
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CORS_ORIGINS=https://workforce.example.com
TRUST_PROXY=true
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Never set this to false in production — the API refuses to start with the login
# throttle disabled.
AUTH_RATE_LIMIT_ENABLED=true
MAX_DAILY_HOURS=8
SHIFTS=GENERAL:09:00-17:00
BADGEVIEW_SYNC_ENABLED=false
# Set CREDENTIAL_DELIVERY_ENABLED=true and configure SMTP_* before onboarding users
# from the UI, otherwise new accounts receive no usable password.
CREDENTIAL_DELIVERY_ENABLED=false
CREDENTIAL_DELIVERY_CRON=*/5 * * * *
CREDENTIAL_DELIVERY_RECIPIENT=it.support@yourdomain.example
TEMP_PASSWORD_EXPIRY_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TZ=Asia/Kolkata
